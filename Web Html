  <script>
    const diseases = [
      { id: 'hta', label: 'Hipertensión', badge: 'pm-badge-warn' },
      { id: 'diabetes', label: 'Diabetes', badge: 'pm-badge-warn' },
      { id: 'epoc', label: 'EPOC', badge: 'pm-badge-danger' },
      { id: 'arritmia', label: 'Arritmia', badge: 'pm-badge-danger' },
      { id: 'asma', label: 'Asma', badge: 'pm-badge-warn' },
      { id: 'anemia', label: 'Anemia', badge: 'pm-badge-info' },
    ];
    let active = new Set(['hta', 'epoc']);

    function renderDiseases() {
      const pillsEl = document.getElementById('disease-pills');
      const badgesEl = document.getElementById('disease-badges');
      pillsEl.innerHTML = diseases.map(d =>
        `<span class="pm-disease-pill ${active.has(d.id)?'active':''}" onclick="toggleDis('${d.id}')">${d.label}</span>`
      ).join('');
      badgesEl.innerHTML = [...active].map(id => {
        const d = diseases.find(x=>x.id===id);
        return d ? `<span class="pm-badge ${d.badge}">${d.label}</span>` : '';
      }).join('');
    }

    function toggleDis(id) {
      active.has(id) ? active.delete(id) : active.add(id);
      renderDiseases();
      update();
    }

    function update() {
      const spo2 = parseFloat(document.getElementById('spo2-ctrl').value);
      const bpm = parseInt(document.getElementById('bpm-ctrl').value);

      document.getElementById('spo2-show').textContent = spo2 + ' %';
      document.getElementById('bpm-show').textContent = bpm + ' bpm';
      document.getElementById('val-spo2').textContent = spo2;
      document.getElementById('val-bpm').textContent = bpm;

      let spo2State, bpmState;
      if (spo2 < 90) spo2State = 'danger';
      else if (spo2 < 95) spo2State = 'warning';
      else spo2State = 'ok';

      const hasArritmia = active.has('arritmia');
      if (bpm < 50 || bpm > 120) bpmState = 'danger';
      else if (bpm < 60 || bpm > 100 || hasArritmia) bpmState = 'warning';
      else bpmState = 'ok';

      const col = s => s==='ok' ? '#639922' : s==='warning' ? '#EF9F27' : '#E24B4A';
      setVital('spo2', spo2State, ((spo2-80)/20)*100, col(spo2State));
      setVital('bpm', bpmState, Math.min(((bpm-30)/150)*100,100), col(bpmState));

      buildDiags(spo2, spo2State, bpm, bpmState);
    }

    function setVital(id, state, pct, color) {
      const card = document.getElementById('card-'+id);
      const icon = document.getElementById('icon-'+id);
      const bar = document.getElementById('bar-'+id);
      const statusEl = document.getElementById('status-'+id);
      card.className = 'pm-vital ' + state;
      icon.className = 'pm-vital-icon ' + state;
      bar.style.width = Math.round(pct) + '%';
      bar.style.background = color;
      const labels = {
        spo2: { ok:'Normal', warning:'Bajo', danger:'Crítico' },
        bpm: { ok:'Normal', warning:'Irregular', danger:'Crítico' }
      };
      statusEl.textContent = labels[id][state];
      statusEl.className = 'pm-vital-status status-'+state;
    }

    function buildDiags(spo2, s0, bpm, sb) {
      const diags = [];

      if (fallState === 'alert') {
        diags.push({ cls:'danger', icon:'ti-alert-triangle', title:'Caída detectada', body:'El paciente no se movió después del impacto. Se envía una alerta automática a los contactos de emergencia.' });
      }

      if (s0 === 'danger') {
        const msg = active.has('epoc') || active.has('asma')
          ? `SpO₂ ${spo2}%. En pacientes con EPOC/Asma, esto representa insuficiencia respiratoria severa.`
          : `SpO₂ ${spo2}%. Hipoxemia grave. Requiere oxígeno suplementario de emergencia.`;
        diags.push({ cls:'danger', icon:'ti-urgent', title:'Hipoxemia grave', body: msg });
      } else if (s0 === 'warning') {
        const msg = active.has('anemia')
          ? `SpO₂ ${spo2}%. En pacientes con anemia, la capacidad de transporte de O₂ ya está comprometida. Monitorear.`
          : `SpO₂ ${spo2}%. Saturación baja. Asegurarse de que el sensor esté bien colocado y observar evolución.`;
        diags.push({ cls:'warning', icon:'ti-droplet', title:'Saturación baja', body: msg });
      } else {
        diags.push({ cls:'ok', icon:'ti-droplet', title:'Oxigenación normal', body:`SpO₂ ${spo2}%, dentro del rango seguro (95–100%).` });
      }

      if (sb === 'danger') {
        if (bpm > 120) diags.push({ cls:'danger', icon:'ti-heart-off', title:'Taquicardia severa', body:`Frecuencia cardíaca de ${bpm} bpm. Riesgo de fallo cardíaco. Actuar de inmediato.` });
        else diags.push({ cls:'danger', icon:'ti-heart-off', title:'Bradicardia severa', body:`Frecuencia cardíaca de ${bpm} bpm. El corazón no bombea suficiente sangre. Atención urgente.` });
      } else if (sb === 'warning') {
        const msg = active.has('arritmia')
          ? `BPM: ${bpm}. En pacientes con arritmia, cualquier variación fuera del rango habitual requiere atención.`
          : active.has('hta')
            ? `BPM: ${bpm}. En pacientes con hipertensión, la frecuencia elevada aumenta el riesgo cardiovascular.`
            : `Frecuencia cardíaca de ${bpm} bpm. Levemente fuera del rango ideal (60–100 bpm). Monitorear.`;
        diags.push({ cls:'warning', icon:'ti-heart-rate-monitor', title:'Frecuencia irregular', body: msg });
      } else {
        diags.push({ cls:'ok', icon:'ti-heart-rate-monitor', title:'Ritmo cardíaco normal', body:`Frecuencia de ${bpm} bpm dentro del rango normal.` });
      }

      if (active.has('epoc') && spo2 < 95) {
        diags.push({ cls:'warning', icon:'ti-lungs', title:'Alerta EPOC', body:'La SpO₂ baja combinada con EPOC indica posible exacerbación. Evaluar broncodilatador.' });
      }
      if (active.has('hta') && bpm > 100) {
        diags.push({ cls:'warning', icon:'ti-gauge', title:'Alerta Hipertensión', body:'La taquicardia en pacientes hipertensos puede indicar crisis hipertensiva. Medir presión arterial.' });
      }

      document.getElementById('diags').innerHTML = diags.map(d =>
        `<div class="pm-diag diag-${d.cls}">
          <i class="ti ${d.icon} pm-diag-icon ${d.cls}" aria-hidden="true"></i>
          <div>
            <div class="pm-diag-head">${d.title}</div>
            <div class="pm-diag-body">${d.body}</div>
          </div>
        </div>`
      ).join('');
    }

    /* ---- Simulador de caídas ---- */
    let fallState = 'idle'; // 'idle' | 'impact' | 'alert'
    let fallTick = null, fallTimer = null;
    const FALL_SIM_MS = 3000;

    function fallUI(mode, title, sub) {
      const card = document.getElementById('fall-card');
      const icon = document.getElementById('fall-icon');
      card.classList.remove('is-active', 'is-alert');
      document.getElementById('fall-dismiss').style.display = 'none';
      if (mode === 'alert') {
        card.classList.add('is-alert');
        icon.innerHTML = '<i class="ti ti-alert-triangle" aria-hidden="true"></i>';
        document.getElementById('fall-dismiss').style.display = 'inline-block';
      } else {
        card.classList.add('is-active');
        icon.innerHTML = '<i class="ti ti-user-check" aria-hidden="true"></i>';
      }
      document.getElementById('fall-title').textContent = title;
      document.getElementById('fall-sub').textContent = sub;
    }

    function setFallButtons(disabled) {
      document.getElementById('btn-fall').disabled = disabled;
    }

    function showG(g) { document.getElementById('fall-g').textContent = g.toFixed(2); }

    function runImpact(onEnd) {
      if (fallState !== 'idle') return;
      fallState = 'impact';
      setFallButtons(true);
      showG(5.0);
      fallUI('active', 'Impacto detectado', 'Verificando si la persona se levanta...');
      fallTick = setInterval(() => {
        showG(1 + (Math.random() - 0.5) * 0.1);
      }, 200);
      fallTimer = setTimeout(() => { clearInterval(fallTick); onEnd(); }, FALL_SIM_MS);
    }

    function simulateFall() {
      runImpact(() => {
        fallState = 'alert';
        showG(1.0);
        const hora = new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
        document.getElementById('fall-last').textContent = 'Hoy ' + hora;
        fallUI('alert', '¡Caída detectada!', 'El paciente no se movió después del impacto');
        update();
      });
    }

    function dismissFall() {
      fallState = 'idle';
      showG(1.0);
      fallUI('active', 'Monitoreando', 'Acelerómetro activo');
      setFallButtons(false);
      update();
    }

    // Menú hamburguesa (celular)
    function toggleMobileMenu() {
      document.getElementById('navLinks').classList.toggle('open');
    }
    document.querySelectorAll('.nav-links a').forEach(link => {
      link.addEventListener('click', () => {
        document.getElementById('navLinks').classList.remove('open');
      });
    });

    renderDiseases();
    fallUI('active', 'Monitoreando', 'Acelerómetro activo');
    update();

    // Highlight sutil al navegar desde el CTA del hero
    document.querySelectorAll('a[href^="#"]').forEach(link => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('href').slice(1);
        const target = document.getElementById(id);
        if (!target) return;
        target.classList.add('pm-highlight');
        setTimeout(() => target.classList.remove('pm-highlight'), 900);
      });
    });
  </script>

