<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="logo.png" type="image/png">
  <title>MOON – Pulsera Inteligente de Monitoreo</title>
  <meta name="description" content="MOON es una pulsera inteligente que detecta caídas, monitorea signos vitales y alerta a contactos de emergencia en tiempo real. Proyecto de la Escuela de Educación Técnica N°7, Taller Regional Quilmes." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="MOON – Pulsera Inteligente de Monitoreo" />
  <meta property="og:description" content="Detecta caídas, mide signos vitales y alerta a tus contactos de emergencia en tiempo real." />
  <meta property="og:image" content="https://proyectomoon.github.io/Web/logo-glass.png" />
  <meta property="og:url" content="https://proyectomoon.github.io/Web/" />
  <meta name="twitter:card" content="summary_large_image" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --night: #0b0f1a;
      --deep: #111827;
      --surface: #161d2e;
      --card: #1e2840;
      --border: #263050;
      --blue: #243869;
      --blue-light: #3a5599;
      --blue-dim: rgba(36, 56, 105, 0.15);
      --moon: #8fa8c8;
      --moon-dim: rgba(143,168,200,0.12);
      --text: #e8edf5;
      --text-muted: #8a96a8;
      --text-dim: #5a6478;
      --white: #FFFFFF;

      --color-text-primary: #e8edf5;
      --color-text-secondary: #8a96a8;
      --color-background-primary: #1e2840;
      --color-background-secondary: #161d2e;
      --color-border-tertiary: #263050;
      --color-border-secondary: #2e3a58;
      --border-radius-lg: 12px;
      --border-radius-md: 8px;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--night);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      line-height: 1.6;
    }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(11,15,26,0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 5%;
      height: 64px;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 0.6rem;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.4rem; font-weight: 700; letter-spacing: 0.2em;
      color: var(--blue);
      text-decoration: none;
    }
    .nav-logo-icon {
      width: 30px; height: auto;
      flex-shrink: 0;
    }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a {
      color: var(--text-muted); text-decoration: none;
      font-size: 0.875rem; font-weight: 500; letter-spacing: 0.05em;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--moon); }

    /* Botón hamburguesa (solo se ve en celular, ver media query al final) */
    .nav-burger {
      display: none;
      background: none;
      border: none;
      color: var(--blue);
      font-size: 1.5rem;
      cursor: pointer;
      padding: 4px;
      line-height: 0;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center;
      padding: 80px 5% 60px;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(212,168,67,0.07) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-icon-bg {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -54%);
      width: clamp(320px, 38vw, 560px);
      height: auto;
      opacity: 0.55;
      pointer-events: none;
      z-index: 0;
      user-select: none;
    }
    .hero h1, .hero-tagline, .hero-cta { position: relative; z-index: 1; }
    .hero h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(4rem, 12vw, 9rem);
      font-weight: 700; letter-spacing: 0.15em;
      line-height: 1;
      background: linear-gradient(135deg, var(--blue-light) 0%, var(--blue) 50%, var(--moon) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 1.5rem;
    }
    .hero-tagline {
      font-size: clamp(1rem, 2.5vw, 1.25rem);
      color: var(--text-muted);
      max-width: 560px;
      line-height: 1.7;
      margin-bottom: 2.5rem;
    }
    .hero-cta {
      display: inline-block;
      background: var(--blue);
      color: var(--white);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600; font-size: 0.9rem; letter-spacing: 0.08em;
      padding: 14px 32px; border-radius: 4px;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s;
    }
    .hero-cta:hover { background: var(--blue-light); transform: translateY(-2px); }

    /* SECTIONS */
    section { padding: 80px 5%; scroll-margin-top: 64px; transition: box-shadow 0.6s ease; }
    section.pm-highlight { box-shadow: inset 0 0 0 1px var(--blue-light); }

    /* CTA FINAL */
    #contacto {
      background: var(--night);
      text-align: center;
      display: flex; flex-direction: column; align-items: center;
    }
    #contacto .section-title { margin-bottom: 0.8rem; }
    #contacto .section-body { max-width: 480px; margin: 0 auto 2rem; }
    .contacto-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }
    .contacto-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600; font-size: 0.85rem; letter-spacing: 0.06em;
      padding: 12px 26px; border-radius: 4px;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s, border-color 0.2s;
    }
    .contacto-btn.primary { background: var(--blue); color: var(--white); }
    .contacto-btn.primary:hover { background: var(--blue-light); transform: translateY(-2px); }
    .contacto-btn.secondary { background: transparent; color: var(--text); border: 1px solid var(--border); }
    .contacto-btn.secondary:hover { border-color: var(--blue-light); color: var(--moon); transform: translateY(-2px); }
    .section-label {
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--blue); margin-bottom: 1rem;
    }
    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(1.6rem, 4vw, 2.4rem);
      font-weight: 600; line-height: 1.2;
      color: var(--text);
      margin-bottom: 1.2rem;
    }
    .section-body {
      color: var(--text-muted); max-width: 640px; line-height: 1.8;
    }
    .divider {
      height: 1px; background: var(--border);
      margin: 0 5%;
    }

    /* MONITOR DE PACIENTE */
    #monitor { background: var(--night); }

    .pm-root { font-family: 'Space Grotesk', 'Inter', sans-serif; padding: 0; }
    .pm-header { margin-bottom: 1.5rem; }
    .pm-label { font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #3a5599; margin-bottom: 0.4rem; }
    .pm-title { font-size: 22px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 0.25rem; }
    .pm-sub { font-size: 14px; color: var(--color-text-secondary); }
    .pm-patient { background: var(--color-background-primary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .pm-avatar { width: 52px; height: 52px; border-radius: 50%; background: #1e2840; border: 1.5px solid #3a5599; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 600; color: #8fa8c8; flex-shrink: 0; }
    .pm-patient-info { flex: 1; min-width: 160px; }
    .pm-patient-name { font-size: 16px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 2px; }
    .pm-patient-meta { font-size: 13px; color: var(--color-text-secondary); }
    .pm-badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .pm-badge { font-size: 12px; font-weight: 500; padding: 4px 12px; border-radius: 20px; }
    .pm-badge-warn { background: rgba(239,159,39,0.16); color: #f0b558; border: 1px solid rgba(239,159,39,0.35); }
    .pm-badge-danger { background: rgba(226,75,74,0.16); color: #f18988; border: 1px solid rgba(226,75,74,0.35); }
    .pm-badge-ok { background: rgba(99,153,34,0.16); color: #9bd15a; border: 1px solid rgba(99,153,34,0.35); }
    .pm-badge-info { background: rgba(58,85,153,0.18); color: #8fa8c8; border: 1px solid rgba(58,85,153,0.4); }
    .pm-vitals-title { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); margin-bottom: 1rem; }
    .pm-vitals { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 1.5rem; }
    .pm-vital { background: var(--color-background-primary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 1.1rem 1.25rem; position: relative; overflow: hidden; transition: border-color 0.2s; }
    .pm-vital.danger { border-color: #E24B4A; }
    .pm-vital.warning { border-color: #EF9F27; }
    .pm-vital.ok { border-color: #639922; }
    .pm-vital-icon { font-size: 20px; margin-bottom: 10px; }
    .pm-vital-icon.danger { color: #E24B4A; }
    .pm-vital-icon.warning { color: #BA7517; }
    .pm-vital-icon.ok { color: #639922; }
    #icon-bpm i { display: inline-block; animation: pm-heartbeat 1.4s ease-in-out infinite; }
    @keyframes pm-heartbeat {
      0%, 100% { transform: scale(1); }
      15% { transform: scale(1.18); }
      30% { transform: scale(1); }
      45% { transform: scale(1.12); }
      60% { transform: scale(1); }
    }
    .pm-vital-name { font-size: 12px; color: var(--color-text-secondary); margin-bottom: 4px; font-weight: 500; letter-spacing: 0.05em; }
    .pm-vital-val { font-size: 28px; font-weight: 500; color: var(--color-text-primary); line-height: 1; margin-bottom: 3px; }
    .pm-vital-unit { font-size: 12px; color: var(--color-text-secondary); display: inline; }
    .pm-vital-status { font-size: 12px; font-weight: 600; margin-top: 8px; padding: 3px 10px; border-radius: 12px; display: inline-block; }
    .status-danger { background: rgba(226,75,74,0.16); color: #f18988; border: 1px solid rgba(226,75,74,0.35); }
    .status-warning { background: rgba(239,159,39,0.16); color: #f0b558; border: 1px solid rgba(239,159,39,0.35); }
    .status-ok { background: rgba(99,153,34,0.16); color: #9bd15a; border: 1px solid rgba(99,153,34,0.35); }
    .pm-bar { height: 4px; border-radius: 2px; margin-top: 10px; background: var(--color-border-tertiary); }
    .pm-bar-fill { height: 4px; border-radius: 2px; transition: width 0.4s; }
    .pm-diag-title { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); margin-bottom: 1rem; }
    .pm-diags { display: flex; flex-direction: column; gap: 10px; }
    .pm-diag { display: flex; align-items: flex-start; gap: 12px; background: var(--color-background-secondary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-md); padding: 14px 16px; border-left: 3px solid transparent; }
    .pm-diag.diag-danger { border-left-color: #E24B4A; }
    .pm-diag.diag-warning { border-left-color: #EF9F27; }
    .pm-diag.diag-ok { border-left-color: #639922; }
    .pm-diag-icon { font-size: 20px; flex-shrink: 0; margin-top: 1px; }
    .pm-diag-icon.danger { color: #E24B4A; }
    .pm-diag-icon.warning { color: #BA7517; }
    .pm-diag-icon.ok { color: #639922; }
    .pm-diag-head { font-size: 14px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 2px; }
    .pm-diag-body { font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; }
    .pm-controls { background: var(--color-background-secondary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; }
    .pm-ctrl-title { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); margin-bottom: 1rem; }
    .pm-ctrl-row { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
    .pm-ctrl-row:last-child { margin-bottom: 0; }
    .pm-ctrl-label { font-size: 13px; color: var(--color-text-secondary); width: 140px; flex-shrink: 0; }
    .pm-ctrl-row input[type=range] { flex: 1; min-width: 100px; accent-color: #3a5599; }
    .pm-ctrl-val { font-size: 14px; font-weight: 500; color: var(--color-text-primary); min-width: 56px; text-align: right; }
    .pm-diseases { margin-bottom: 1.5rem; }
    .pm-diseases-label { font-size: 13px; color: var(--color-text-secondary); margin-bottom: 8px; }
    .pm-diseases-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .pm-disease-pill { font-size: 12px; font-weight: 500; padding: 5px 14px; border-radius: 20px; cursor: pointer; border: 0.5px solid var(--color-border-secondary); background: var(--color-background-primary); color: var(--color-text-secondary); transition: all 0.15s; user-select: none; }
    .pm-disease-pill.active { background: #1e2840; color: #8fa8c8; border-color: #3a5599; }

    /* DETECCIÓN DE CAÍDAS (demo) */
    .pt-fall-card { background: var(--color-background-primary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 1.1rem 1.25rem; margin-bottom: 1.5rem; transition: border-color 0.25s; }
    .pt-fall-card.is-active { border-color: #639922; }
    .pt-fall-card.is-alert { border-color: #E24B4A; animation: pm-alarm-flash 1s infinite; }
    @keyframes pm-alarm-flash { 0%, 100% { opacity: 1; } 50% { opacity: 0.65; } }
    .pt-fall-head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .pt-fall-icon { width: 42px; height: 42px; border-radius: 50%; background: var(--color-background-secondary); border: 1.5px solid var(--color-border-secondary); display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--moon); flex-shrink: 0; }
    .pt-fall-card.is-active .pt-fall-icon { border-color: #639922; color: #9bd15a; }
    .pt-fall-card.is-alert .pt-fall-icon { border-color: #E24B4A; color: #f18988; }
    .pt-fall-info { flex: 1; min-width: 150px; }
    .pt-fall-title { font-size: 14px; font-weight: 500; color: var(--color-text-primary); }
    .pt-fall-sub { font-size: 12px; color: var(--text-dim); }
    .pt-fall-metrics { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.9rem; font-size: 12.5px; color: var(--text-muted); }
    .pt-fall-metrics b { color: var(--text); font-weight: 500; }
    .pt-fall-controls { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 0.9rem; }
    .pm-sim-btn { background: none; border: 1px solid var(--border); color: var(--text-muted); font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 500; padding: 8px 16px; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: border-color 0.2s, color 0.2s; }
    .pm-sim-btn:hover:not([disabled]) { border-color: var(--blue-light); color: var(--moon); }
    .pm-sim-btn[disabled] { opacity: 0.5; cursor: default; }
    .pt-fall-dismiss { display: none; background: #E24B4A; color: #fff; border: none; font-family: 'Inter', sans-serif; font-size: 0.8rem; font-weight: 600; padding: 8px 16px; border-radius: 20px; cursor: pointer; }

    /* OBJETIVO */
    #objetivo { background: var(--deep); }

    .objetivo-desc {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.7;
      max-width: 560px;
      margin-bottom: 2.5rem;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      margin-top: 2rem;
    }

    .feature-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: border-color 0.2s, transform 0.2s;
    }
    .feature-card:hover {
      border-color: var(--blue-light);
      transform: translateY(-3px);
    }
    .feature-card .card-icon {
      font-size: 22px;
      color: var(--moon);
    }
    .feature-card .card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
    }
    .feature-card .card-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* COMPONENTES */
    #componentes { background: var(--deep); }
    .components-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }
    .component-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 6px;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s;
    }
    .component-card:hover { border-color: var(--blue-light); transform: translateY(-3px); }
    .component-body { padding: 1.4rem; }
    .component-name {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem; font-weight: 600;
      color: var(--text); margin-bottom: 0.3rem;
    }
    .component-role { font-size: 0.78rem; color: var(--white); margin-bottom: 0.7rem; font-weight: 500; }
    .component-desc { font-size: 0.83rem; color: var(--text-muted); line-height: 1.6; }

    /* EQUIPO */
    #equipo { background: var(--night); }

    .members-list {
      display: flex; flex-wrap: wrap; gap: 0.75rem;
      margin-top: 2rem;
    }
    .member-pill {
      display: flex; align-items: center; gap: 0.6rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 40px;
      padding: 8px 18px 8px 8px;
      font-size: 0.88rem; color: var(--text);
      font-family: 'Space Grotesk', sans-serif; font-weight: 500;
    }
    .member-initials {
      width: 32px; height: 32px; flex-shrink: 0;
      background: var(--blue-dim); border: 1px solid var(--blue);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.72rem; font-weight: 700; color: var(--blue);
    }

    .contrib-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
      margin-top: 1.5rem;
    }
    .contrib-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.4rem;
      transition: border-color 0.2s;
    }
    .contrib-card:hover { border-color: var(--blue); }
    .contrib-header {
      display: flex; align-items: center; gap: 1rem;
      margin-bottom: 0.9rem;
    }
    .contrib-avatar {
      width: 42px; height: 42px; flex-shrink: 0;
      background: var(--blue-dim); border: 1px solid var(--blue);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.85rem; font-weight: 700; color: var(--blue);
    }
    .contrib-name {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem; font-weight: 700; color: var(--text);
      margin-bottom: 0.2rem;
    }
    .contrib-role { font-size: 0.72rem; color: var(--white); font-weight: 500; }
    .contrib-desc { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; }

    /* CRONOGRAMA */
    #cronograma { background: var(--deep); }
    .cronograma-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 2.5rem;
      max-width: 720px;
    }
    .crono-item {
      display: flex; align-items: flex-start; gap: 1.2rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1.2rem 1.4rem;
      transition: border-color 0.2s;
    }
    .crono-item:hover { border-color: var(--blue-light); }
    .crono-num {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.3rem; font-weight: 700;
      color: var(--blue-light);
      min-width: 32px;
    }
    .crono-fase {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem; font-weight: 600;
      color: var(--text); margin-bottom: 0.2rem;
    }
    .crono-desc { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; }

    /* FOOTER */
footer {
  background: var(--night);
  border-top: 1px solid var(--border);
  padding: 2.5rem 5%;
  display: grid;
