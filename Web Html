    .pm-vital {
      padding: 1.25rem 1.35rem 1.2rem;
      display: grid; grid-template-columns: 1fr auto;
      grid-template-areas: "name icon" "val icon" "status status";
      align-items: start;
    }
    .pm-vital.ok { border-color: var(--ok-line); }
    .pm-vital.warning { border-color: rgba(239,159,39,0.45); }
    .pm-vital.danger { border-color: rgba(226,75,74,0.6); }
    .pm-vital-name { grid-area: name; font-size: 13px; color: var(--text-muted); margin-bottom: 6px; }
    .pm-vital > div:nth-of-type(3) { grid-area: val; }
    .pm-vital-icon {
      grid-area: icon; width: 44px; height: 44px; border-radius: 14px; margin: 0;
      display: flex; align-items: center; justify-content: center; font-size: 22px;
      background: rgba(255,255,255,0.04); color: var(--text-muted);
    }
    .pm-vital-icon.ok { background: var(--ok-soft); color: var(--ok); }
    .pm-vital-icon.warning { background: var(--warn-soft); color: var(--warn); }
    .pm-vital-icon.danger { background: var(--crit-soft); color: var(--crit); }
    .pm-vital-val {
      font-family: 'Space Grotesk', sans-serif; font-size: 46px; font-weight: 600;
      letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
    }
    .pm-vital-unit { font-size: 14px; margin-left: 2px; }
    .pm-bar { display: none; }
    .pm-vital-status { grid-area: status; justify-self: start; margin-top: 12px; font-size: 11.5px; letter-spacing: 0.03em; padding: 4px 11px; }
    .pm-vital-status:empty { display: none; }

    /* Caídas */
    .pt-fall-card { padding: 1.15rem 1.25rem; }
    .pt-fall-icon {
      width: 46px; height: 46px; border-radius: 14px;
      background: rgba(58,85,153,0.18); border: 1px solid rgba(58,85,153,0.4); color: #8fa8c8;
    }
    .pt-fall-card.is-active { border-color: var(--ok-line); }
    .pt-fall-card.is-active .pt-fall-icon { background: var(--ok-soft); border-color: var(--ok-line); color: var(--ok); }
    .pt-fall-card.is-alert .pt-fall-icon { background: var(--crit-soft); border-color: var(--crit-line); color: var(--crit); }
    .pt-fall-title { font-size: 15px; font-weight: 600; }
    .pt-fall-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 1rem; }
    .pt-fall-metrics > div { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; }
    .pt-fall-metrics b { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-variant-numeric: tabular-nums; }
    .pt-fall-dismiss { border-radius: 999px; padding: 9px 18px; }

    /* Diagnóstico */
    .pm-diags { gap: 10px; }
    .pm-diag {
      background: linear-gradient(180deg, var(--card), var(--surface));
      border: 1px solid var(--border); border-left-width: 3px;
