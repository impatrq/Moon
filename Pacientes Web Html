    // Al entrar al panel: si no hay Bluetooth, avisar de entrada (no recién al tocar Conectar)
    function ptCheckBluetoothSupport() {
      const help = document.getElementById('pt-ble-help');
      if (!navigator.bluetooth) {
        ptShowBluetoothHelp();
      } else {
        help.classList.remove('show');
        document.getElementById('pt-ble-btn').style.display = '';
        // En Bluefy (iPhone) no existe getDevices(): hay que elegir la pulsera cada vez
        if (!navigator.bluetooth.getDevices && ptDetectBrowser().isIOS) {
          ptSetBleUI('idle', 'Sin conectar', 'Tocá Conectar y elegí tu pulsera de la lista');
        }
      }
    }

    // Pide al usuario que elija CUALQUIER dispositivo Bluetooth cercano
    // (sin filtrar por nombre ni por servicio), para no depender de cómo
    // se llame la pulsera.
    async function ptConnectBluetooth() {
      if (!navigator.bluetooth) {
        ptShowBluetoothHelp();
        return;
      }
      // El navegador soporta Bluetooth, pero puede estar apagado en el equipo
      if (navigator.bluetooth.getAvailability) {
        try {
          const disponible = await navigator.bluetooth.getAvailability();
          if (!disponible) {
            ptSetBleUI('error', 'El Bluetooth está apagado', 'Prendé el Bluetooth del celular o la compu y tocá Reintentar');
            return;
          }
        } catch (e) { /* si falla la consulta, se intenta conectar igual */ }
      }
      try {
        ptSetBleUI('connecting', 'Buscando dispositivos Bluetooth cercanos...');
        const device = await navigator.bluetooth.requestDevice({
          acceptAllDevices: true,
          // optionalServices es necesario para poder acceder a este
          // servicio después de conectar, aunque no se use como filtro.
          optionalServices: [BLE_SERVICE_UUID]
        });
        await ptConnectToDevice(device);
      } catch (err) {
        console.error('MOON: error de Bluetooth', err);
        // El usuario cerró el selector sin elegir ningún dispositivo
        if (err.name === 'NotFoundError') {
          ptSetBleUI('idle', 'Sin conectar', 'Elegí tu dispositivo de la lista');
        } else {
          ptSetBleUI('error', 'No se pudo conectar', err.message);
        }
      }
    }

    // Conecta con un dispositivo ya elegido (manualmente o por reconexión
    // automática). CUALQUIER dispositivo BLE que acepte la conexión GATT
    // queda "conectado" en la app, tenga o no el servicio de datos de MOON.
    async function ptConnectToDevice(device) {
      document.getElementById('pt-ble-name').textContent = device.name || 'Dispositivo Bluetooth';
      ptSetBleUI('connecting', 'Conectando con ' + (device.name || 'el dispositivo') + '...');
      device.addEventListener('gattserverdisconnected', ptOnBluetoothDisconnected);

      try {
        // 1) Conexión GATT real: esto es lo que define si el dispositivo
        //    queda "conectado" por Bluetooth, y funciona para cualquier
        //    dispositivo BLE, sea o no una pulsera MOON.
        const server = await device.gatt.connect();
        bleDevice = device;
        ptSaveBleDeviceId(device.id);

        // 2) Además, intenta encontrar el servicio/característica de MOON
        //    para poder leer los signos vitales. Si el dispositivo elegido
        //    no lo tiene (otro ESP32 con otro UUID, u otro dispositivo
        //    cualquiera), NO se corta la conexión: queda conectado igual,
        //    solo que sin datos en vivo hasta que ese servicio aparezca.
        try {
          const service = await server.getPrimaryService(BLE_SERVICE_UUID);
          bleCharacteristic = await service.getCharacteristic(BLE_CHARACTERISTIC_UUID);
          await bleCharacteristic.startNotifications();
          bleCharacteristic.addEventListener('characteristicvaluechanged', ptHandleBluetoothData);

          ptSetBleUI('connected', 'Conectada — esperando primer dato...', 'Se va a reconectar sola la próxima vez que entres con esta cuenta');
        } catch (serviceErr) {
          console.warn('MOON: conectado, pero no se encontró el servicio de datos esperado', serviceErr);
          bleCharacteristic = null;
          ptSetBleUI('connected', 'Conectada (sin servicio de datos MOON)', 'Revisá el UUID de servicio/característica en el firmware si esperás ver signos vitales');
        }
      } catch (err) {
        console.error('MOON: no se pudo establecer la conexión Bluetooth', err);
        if (device.gatt && device.gatt.connected) device.gatt.disconnect();
        ptSetBleUI('error', 'No se pudo conectar', err.message);
      }
    }

    // Al entrar al panel, intenta reconectar sola con la última pulsera
    // usada por esta cuenta, sin volver a pedir que se elija de la lista.
    // Solo funciona en navegadores que soportan navigator.bluetooth.getDevices()
    // (Chrome/Edge). En Safari/Firefox simplemente no hace nada.
    async function ptTryAutoReconnect() {
      if (!navigator.bluetooth || !navigator.bluetooth.getDevices) return;
      const savedId = ptGetSavedBleDeviceId();
      if (!savedId) return;
      try {
        const devices = await navigator.bluetooth.getDevices();
        const found = devices.find(d => d.id === savedId);
        if (found) {
          await ptConnectToDevice(found);
        }
      } catch (err) {
        console.warn('MOON: no se pudo reconectar automáticamente', err);
      }
    }

    // ---- Última medición real mientras no llegan datos nuevos ----
    // Si la pulsera está conectada pero el sensor no da una lectura válida,
    // se sigue mostrando la ÚLTIMA medición real, en gris y marcada como
    // "Última medición (hace X s)". No se inventan valores: si todavía no hubo
    // ninguna medición real, se muestra "--".
    // Un valor viejo no cuenta como lectura actual: pasados PT_STALE_ALARM_MS
    // sin datos nuevos deja de mantener la alarma de signos vitales.
    const PT_ESTIMATE_AFTER_MS = 3000;   // espera sin datos nuevos antes de pasar a "última medición"
    const PT_STALE_ALARM_MS = 60000;     // tiempo máximo que un valor viejo mantiene una alarma
    let ptLastRealVitalsTs = 0;
    let ptLastGood = null;               // { spo2, bpm }
    let ptStale = false;

    function ptAgoText(ms) {
      const s = Math.round(ms / 1000);
      if (s < 60) return 'hace ' + s + ' s';
      return 'hace ' + Math.floor(s / 60) + ' min';
    }

    function ptRenderEstimated() {
      if (!ptLastGood) return; // nunca hubo una medición real: queda en "--"
      ptStale = true;
      const edad = Date.now() - ptLastRealVitalsTs;
      const dot = document.getElementById('pt-live-dot');
      dot.style.background = '#EF9F27';
      dot.style.animation = 'none';
      document.getElementById('pt-live-text').textContent =
        'Pulsera conectada — sin lectura nueva del sensor, mostrando la última medición';

      [['spo2', ptLastGood.spo2, ((ptLastGood.spo2 - 80) / 20) * 100],
       ['bpm',  ptLastGood.bpm,  Math.min(((ptLastGood.bpm - 30) / 150) * 100, 100)]].forEach(([id, val, pct]) => {
        document.getElementById('pt-val-' + id).textContent = val;
        document.getElementById('pt-card-' + id).className = 'pm-vital estimated';
        document.getElementById('pt-icon-' + id).className = 'pm-vital-icon';
        const bar = document.getElementById('pt-bar-' + id);
        bar.style.width = Math.max(0, Math.min(100, Math.round(pct))) + '%';
        bar.style.background = '#5a6478';
        const st = document.getElementById('pt-status-' + id);
        st.textContent = 'Última medición · ' + ptAgoText(edad);
        st.className = 'pm-vital-status status-est';
        // Un valor viejo no mantiene una alarma para siempre
        if (edad > PT_STALE_ALARM_MS) ptAlarmState[id] = 'ok';
      });

      document.getElementById('pt-diags').innerHTML =
        '<div class="pm-diag diag-warning"><i class="ti ti-info-circle pm-diag-icon warning" aria-hidden="true"></i><div><div class="pm-diag-head">Sin lectura nueva del sensor</div><div class="pm-diag-body">Se muestra la última medición real (' + ptAgoText(edad) + '). No es el estado actual del paciente. Apoyá el dedo firme y quieto sobre el sensor.</div></div></div>';
    }

    // Texto del valor para el mail: si es una medición vieja, que quede aclarado
    function ptVitalForMail(id) {
      const t = document.getElementById('pt-val-' + id).textContent;
      return ptStale ? t + ' (última medición, no actual)' : t;
    }

    function ptHandleBluetoothData(event) {
      const text = new TextDecoder().decode(event.target.value);
      // Formato: "spo2,bpm,temp" o "spo2,bpm,temp,g"
      console.log('MOON BLE recibido:', text);
      document.getElementById('pt-ble-status').textContent = 'Conectada — recibiendo datos';
      const partes = text.trim().split(',');

      // Signos vitales: solo si los 3 primeros datos son números válidos
      if (partes.length >= 3) {
        const spo2 = parseFloat(partes[0]);
        const bpm = parseFloat(partes[1]);
        const temp = parseFloat(partes[2]);
        if (!isNaN(spo2) && !isNaN(bpm) && !isNaN(temp)) {
          ptLastRealVitalsTs = Date.now();
          ptLastGood = { spo2: spo2, bpm: bpm };
          ptStale = false;
          ptSetLiveVitals(spo2, bpm, temp);
        } else if (Date.now() - ptLastRealVitalsTs > PT_ESTIMATE_AFTER_MS) {
          // Pulsera conectada pero sin lectura válida todavía (dedo mal apoyado,
          // sensor estabilizando): se muestra un valor ESTIMADO, marcado como tal.
          ptRenderEstimated();
        }
      }

      // Aceleración (g): se procesa SIEMPRE que llegue, aunque spo2/bpm/temp
      // vengan en "nan" o vacíos (el sensor de SpO2 a veces no tiene lectura).
      if (partes.length >= 4) {
        const g = parseFloat(partes[3]);
        if (!isNaN(g)) ptProcessG(g);
      }
    }

    // Se dispara tanto si el usuario desconecta a propósito (botón
    // "Desconectar") como si la pulsera se apaga / se aleja / pierde señal.
    // En los dos casos hay que: 1) reflejar "Sin conectar" en la tarjeta BLE,
    // y 2) volver el panel de signos vitales a "esperando datos" para que no
    // quede mostrando el último valor recibido como si siguiera en vivo.
    function ptOnBluetoothDisconnected() {
      bleCharacteristic = null;
      ptSetBleUI('idle', 'Pulsera desconectada', 'Elegí tu dispositivo de la lista');
      ptRenderWaiting();
    }

    // Desconexión manual: además de cortar la conexión, se olvida la
    // pulsera guardada para esta cuenta, así no se intenta reconectar sola
    // la próxima vez (si el usuario la desconectó a propósito).
    function ptDisconnectBluetooth() {
      ptForgetSavedBleDevice();
      if (bleDevice && bleDevice.gatt && bleDevice.gatt.connected) {
        // Esto dispara el evento 'gattserverdisconnected' -> ptOnBluetoothDisconnected,
        // que ya se encarga de actualizar la UI y volver a "esperando datos".
        bleDevice.gatt.disconnect();
      } else {
        // Por si ya estaba desconectado a nivel GATT, igual reseteamos la UI.
        ptOnBluetoothDisconnected();
      }
    }

    function ptRenderVitals(spo2, bpm) {
      document.getElementById('pt-live-dot').style.background = '#639922';
      document.getElementById('pt-live-dot').style.animation = 'pmPulse 1.8s infinite';
      document.getElementById('pt-live-text').textContent = 'Pulsera MOON conectada — datos en tiempo real';

      document.getElementById('pt-val-spo2').textContent = spo2;
      document.getElementById('pt-val-bpm').textContent = bpm;

      let spo2State, bpmState;
      // SpO2: 95-100 = normal | 82-94 = irregular | menos de 82 = crítico (alerta + mail)
      if (spo2 < PT_SPO2_CRITICO) spo2State = 'danger';
      else if (spo2 < PT_SPO2_NORMAL) spo2State = 'warning';
      else spo2State = 'ok';

      // BPM: 60-100 = normal | 50-59 y 101-120 = irregular |
      //      menos de 50 o más de 120 = crítico (alarma + mail)
      if (bpm < PT_BPM_CRITICO_BAJO || bpm > PT_BPM_CRITICO_ALTO) bpmState = 'danger';
      else if (bpm < PT_BPM_NORMAL_MIN || bpm > PT_BPM_NORMAL_MAX) bpmState = 'warning';
      else bpmState = 'ok';

      const estadoPrevio = { spo2: ptAlarmState.spo2, bpm: ptAlarmState.bpm };
      ptSetVital('spo2', spo2State, ((spo2-80)/20)*100, spo2State==='ok'?'#639922':spo2State==='warning'?'#EF9F27':'#E24B4A');
      ptSetVital('bpm', bpmState, Math.min(((bpm-30)/150)*100,100), bpmState==='ok'?'#639922':bpmState==='warning'?'#EF9F27':'#E24B4A');

      // Si algún signo vital recién se puso crítico, es una falla nueva:
      // se saltea la espera y se manda el mail enseguida.
      if ((spo2State === 'danger' && estadoPrevio.spo2 !== 'danger') ||
          (bpmState === 'danger' && estadoPrevio.bpm !== 'danger')) {
        ptLastEmailTs = 0;
        ptCheckAlarm();
      }

      ptBuildDiags(spo2, spo2State, bpm, bpmState);
    }

    // Límites de oxígeno en sangre (SpO2, en %)
    const PT_SPO2_NORMAL  = 95;  // desde acá para arriba: Normal
    const PT_SPO2_CRITICO = 82;  // por debajo de este valor: Crítico (suena la alarma y se manda el mail)

    // Límites de frecuencia cardíaca (BPM / lpm)
    const PT_BPM_NORMAL_MIN   = 60;   // Normal: de 60...
    const PT_BPM_NORMAL_MAX   = 100;  // ...a 100
    const PT_BPM_CRITICO_BAJO = 50;   // menos de 50: Crítico (alarma + mail)
    const PT_BPM_CRITICO_ALTO = 120;  // más de 120: Crítico (alarma + mail)

    function ptSetVital(id, state, pct, color) {
      const card = document.getElementById('pt-card-'+id);
      const icon = document.getElementById('pt-icon-'+id);
      const bar = document.getElementById('pt-bar-'+id);
      const statusEl = document.getElementById('pt-status-'+id);
      card.className = 'pm-vital ' + state;
      icon.className = 'pm-vital-icon ' + state;
      bar.style.width = Math.round(pct) + '%';
      bar.style.background = color;
      const labels = {
        spo2: { ok:'Normal', warning:'Irregular', danger:'Crítico' },
        bpm: { ok:'Normal', warning:'Irregular', danger:'Crítico' }
      };
      statusEl.textContent = labels[id][state];
      statusEl.className = 'pm-vital-status status-'+state;

      // Guarda el estado para que la alarma lo revise
      ptAlarmState[id] = state;
    }

    function ptBuildDiags(spo2, s0, bpm, sb) {
      const diags = [];

      if (s0 === 'danger') {
        const msg = patientActive.has('epoc') || patientActive.has('asma')
          ? `SpO₂ ${spo2}%. En pacientes con EPOC/Asma, esto representa insuficiencia respiratoria severa.`
          : `SpO₂ ${spo2}%. Hipoxemia grave. Requiere oxígeno suplementario de emergencia.`;
        diags.push({ cls:'danger', icon:'ti-urgent', title:'Hipoxemia grave', body: msg });
      } else if (s0 === 'warning') {
        const msg = patientActive.has('anemia')
          ? `SpO₂ ${spo2}%. En pacientes con anemia, la capacidad de transporte de O₂ ya está comprometida. Monitorear.`
          : `SpO₂ ${spo2}%. Saturación baja. Asegurarse de que el sensor esté bien colocado y observar evolución.`;
        diags.push({ cls:'warning', icon:'ti-droplet', title:'Saturación irregular', body: msg });
      } else {
        diags.push({ cls:'ok', icon:'ti-droplet', title:'Oxigenación normal', body:`SpO₂ ${spo2}%, dentro del rango seguro (95–100%).` });
      }

      if (sb === 'danger') {
        if (bpm > PT_BPM_NORMAL_MAX) diags.push({ cls:'danger', icon:'ti-heart-off', title:'Taquicardia severa', body:`Frecuencia cardíaca de ${bpm} bpm. Riesgo de fallo cardíaco. Actuar de inmediato.` });
        else diags.push({ cls:'danger', icon:'ti-heart-off', title:'Bradicardia severa', body:`Frecuencia cardíaca de ${bpm} bpm. El corazón no bombea suficiente sangre. Atención urgente.` });
      } else if (sb === 'warning') {
        const msg = patientActive.has('arritmia')
          ? `BPM: ${bpm}. En pacientes con arritmia, cualquier variación fuera del rango habitual requiere atención.`
          : patientActive.has('hta')
            ? `BPM: ${bpm}. En pacientes con hipertensión, la frecuencia elevada aumenta el riesgo cardiovascular.`
            : `Frecuencia cardíaca de ${bpm} bpm. Levemente fuera del rango ideal (60–100 bpm). Monitorear.`;
        diags.push({ cls:'warning', icon:'ti-heart-rate-monitor', title:'Frecuencia irregular', body: msg });
      } else {
        diags.push({ cls:'ok', icon:'ti-heart-rate-monitor', title:'Ritmo cardíaco normal', body:`Frecuencia de ${bpm} bpm dentro del rango normal.` });
      }

      if (patientActive.has('epoc') && spo2 < 95) {
        diags.push({ cls:'warning', icon:'ti-lungs', title:'Alerta EPOC', body:'La SpO₂ baja combinada con EPOC indica posible exacerbación. Evaluar broncodilatador.' });
      }
      if (patientActive.has('hta') && bpm > 100) {
        diags.push({ cls:'warning', icon:'ti-gauge', title:'Alerta Hipertensión', body:'La taquicardia en pacientes hipertensos puede indicar crisis hipertensiva. Medir presión arterial.' });
      }

      const el = document.getElementById('pt-diags');
      el.innerHTML = diags.map(d =>
        `<div class="pm-diag diag-${d.cls}">
          <i class="ti ${d.icon} pm-diag-icon ${d.cls}" aria-hidden="true"></i>
          <div>
            <div class="pm-diag-head">${d.title}</div>
            <div class="pm-diag-body">${d.body}</div>
          </div>
        </div>`
      ).join('');
    }

    // ==========================================================================
    // ALARMA
    // ==========================================================================

    /* -------------------------------------------------------------------
       CONFIGURACIÓN DE EMAILJS (necesaria para que el mail se mande solo)
       1. Creá una cuenta gratis en https://www.emailjs.com
       2. Agregá un "Email Service" (Gmail, Outlook, etc) y copiá el Service ID
       3. Creá un "Email Template" con variables como {{titulo}}, {{mensaje}},
          {{paciente}} y {{destino}} — y copiá el Template ID
       4. En "Account > General" copiá tu Public Key
       5. Reemplazá los tres valores de acá abajo
    ------------------------------------------------------------------- */
    const EMAILJS_PUBLIC_KEY  = 'N9FKmH8nhfya8L5d7';
    const EMAILJS_SERVICE_ID  = 'service_w2r8stx';
    const EMAILJS_TEMPLATE_ID = 'template_5w0va9e';

    if (window.emailjs && EMAILJS_PUBLIC_KEY !== 'TU_PUBLIC_KEY') {
      emailjs.init(EMAILJS_PUBLIC_KEY);
    }

    // Limpia un email: saca espacios y caracteres invisibles que a veces agrega
    // el teclado del celular (iPhone, autocompletar, copiar/pegar) y que hacen
    // que EmailJS lo rechace con "422 The recipients address is corrupted".
    function ptLimpiarEmail(e) {
      return String(e || '')
        .replace(/[\s\u200B-\u200D\u2060\uFEFF\u00A0]/g, '')
        .replace(/[\uFF20\uFE6B]/g, '@')
        .toLowerCase();
    }
    function ptEmailValido(e) {
      return /^[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$/.test(e);
    }

    function ptGetEmergencyEmail() {
      // Las alertas van al email que se cargó en el perfil del paciente.
      // Si no se cargó ninguno (o está mal escrito), se usa el email con el
      // que se inició sesión.
      const session = ptGetSession();
      if (!session) return '';
      const profile = ptGetMyProfile();
      const alerta = ptLimpiarEmail(profile && profile.alertEmail);
      if (ptEmailValido(alerta)) return alerta;
      const cuenta = ptLimpiarEmail(session.email);
      return ptEmailValido(cuenta) ? cuenta : '';
    }

    // Tiempo entre RECORDATORIOS mientras la misma emergencia sigue activa.
    // Una falla nueva (caída nueva, o un signo vital que recién se pone crítico)
    // manda el mail enseguida, sin esperar. Para recordatorios más seguidos,
    // bajá estos valores, ej: 30 * 1000 (30 segundos).
    const EMAILJS_COOLDOWN_FALL_MS   = 30 * 1000;       // caídas: recordatorio cada 30 segundos
    const EMAILJS_COOLDOWN_VITALS_MS = 60 * 1000;       // signos vitales: recordatorio cada 1 minuto
    const EMAILJS_GAP_MS = 1500; // separación mínima entre dos envíos seguidos
    let ptLastEmailTs = 0;      // espera entre mails de signos vitales
    let ptLastFallEmailTs = 0;  // espera propia para mails de caída (independiente de los vitales)

    // Verifica que haya sesión y que EmailJS esté cargado y configurado
    function ptEmailListo() {
      if (!ptGetSession()) return false; // no hay sesión, no se manda nada
      if (!ptGetEmergencyEmail()) {
        const profile = ptGetMyProfile();
        const malo = (profile && profile.alertEmail) || ptGetSession().email || '(vacío)';
        ptMailStatus(false, 'El email de alertas "' + malo + '" no es válido. Corregilo en "Editar perfil".');
        return false;
      }
      if (!window.emailjs || EMAILJS_PUBLIC_KEY === 'TU_PUBLIC_KEY' || EMAILJS_TEMPLATE_ID === 'TU_TEMPLATE_ID') {
        console.warn('MOON: falta configurar EmailJS (Service ID / Template ID / Public Key) o no cargó la librería.');
        ptMailStatus(false, 'EmailJS no está configurado o no cargó la librería.');
        return false;
      }
      return true;
    }

    // Datos comunes a todos los mails de emergencia
    function ptEmailBase(extra) {
      const destino = ptGetEmergencyEmail();
      const profile = ptGetMyProfile();
      return Object.assign({
        destino: destino,
        to_email: destino,
        email: destino,
        paciente: profile ? profile.name : 'Paciente',
        name: 'MOON',
        bpm: ptVitalForMail('bpm'),
        spo2: ptVitalForMail('spo2'),
        fecha: new Date().toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' })
      }, extra);
    }

    // Muestra en pantalla (tarjeta de caídas) si el mail salió o falló y por qué.
    function ptMailStatus(ok, text) {
      const el = document.getElementById('pt-mail-status');
      if (!el) return;
      el.style.display = 'block';
      el.style.color = ok ? '#9bd15a' : '#f2a3a2';
      el.textContent = (ok ? '✉ ' : '⚠ ') + text;
    }

    // Cola de envío: EmailJS rechaza pedidos pegados (tiene un límite por segundo),
    // así que los mails salen de a uno, con una pausa entre cada uno.
    // El de caída va siempre primero.
    const ptEmailQueue = [];
    let ptEmailBusy = false;

    function ptEnqueueEmail(job, urgente) {
      if (urgente) ptEmailQueue.unshift(job); else ptEmailQueue.push(job);
      ptRunEmailQueue();
    }

    async function ptRunEmailQueue() {
      if (ptEmailBusy) return;
      ptEmailBusy = true;
      while (ptEmailQueue.length) {
        const job = ptEmailQueue.shift();
        try {
          await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, job.params);
          const hora = new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
          console.log('MOON: ' + job.label + ' enviado a ' + job.params.to_email);
          ptMailStatus(true, 'Mail de ' + job.label + ' enviado a ' + job.params.to_email + ' (' + hora + ')');
        } catch (err) {
          const motivo = (err && (err.text || err.message))
            ? ((err.status ? err.status + ' · ' : '') + (err.text || err.message))
            : 'error desconocido';
          console.error('MOON: error al enviar el mail de ' + job.label, err);
          ptMailStatus(false, 'No se pudo enviar el mail de ' + job.label + ' a "' + job.params.to_email + '": ' + motivo);
          if (job.onFail) job.onFail(); // permite reintentar en el próximo chequeo
        }
        await new Promise(r => setTimeout(r, EMAILJS_GAP_MS));
      }
      ptEmailBusy = false;
    }

    // Mail por signos vitales críticos (solo vitales, las caídas tienen su propia función)
    function ptSendEmergencyEmail(criticos) {
      if (!ptEmailListo()) return;
      if (Date.now() - ptLastEmailTs < EMAILJS_COOLDOWN_VITALS_MS) return;
      ptLastEmailTs = Date.now();
      ptEnqueueEmail({
        label: 'signos vitales',
        params: ptEmailBase({
          caida: ptAlarmState.caida === 'danger' ? 'Sí' : 'No', // si justo hay una caída activa, que el mail lo refleje
          titulo: 'Alerta MOON — valor crítico',
          mensaje: 'Valor crítico en: ' + criticos.join(', ') + '.'
        }),
        onFail: () => { ptLastEmailTs = 0; }
      }, false);
    }

    // Mail por caída detectada (con su propio contador de espera y prioridad)
    function ptSendFallEmail() {
      if (!ptEmailListo()) return;
      if (Date.now() - ptLastFallEmailTs < EMAILJS_COOLDOWN_FALL_MS) return;
      ptLastFallEmailTs = Date.now();
      const profile = ptGetMyProfile();
      const nombre = profile ? profile.name : 'Paciente';
      ptEnqueueEmail({
        label: 'caída',
        params: ptEmailBase({
          caida: 'Sí',
          titulo: 'Alerta MOON — caída detectada',
          mensaje: 'El paciente ' + nombre + ' sufrió una CAÍDA y no se movió después del impacto.'
        }),
        onFail: () => { ptLastFallEmailTs = 0; }
      }, true);
    }

    // Ya no existe "silenciar": mientras el signo vital siga en "danger",
    // el cartel se muestra, suena el beep y se reenvía el mail en cada
    // chequeo (cada ptAlarmSeconds segundos), sin forma de detenerlo desde
    // la interfaz — solo se apaga solo cuando el valor deja de ser crítico
    // (o la pulsera se desconecta, ver ptRenderWaiting).
    let ptAlarmState = { spo2: 'ok', bpm: 'ok', caida: 'ok' };
    let ptAlarmTimer = null;
    const ptAlarmSeconds = 10; // cada 10 segundos se revisa y, si corresponde, se manda el mail de nuevo

    // Beep simple con Web Audio API (no necesita ningún archivo de sonido)
    function ptBeep() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = 880;
        gain.gain.value = 0.18;
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        setTimeout(() => {
          osc.stop();
          ctx.close();
        }, 350);
      } catch (e) {
        // Si el navegador bloquea el audio hasta que haya una interacción,
        // el cartel visual igual va a aparecer.
      }
    }

    // Se ejecuta cada N segundos: revisa si algún signo vital está en "danger"
    function ptCheckAlarm() {
      const banner = document.getElementById('pt-alarm-banner');
      const textEl = document.getElementById('pt-alarm-text');
      const criticos = [];
      if (ptAlarmState.spo2 === 'danger') criticos.push('oxígeno en sangre');
      if (ptAlarmState.bpm === 'danger') criticos.push('frecuencia cardíaca');
      if (ptAlarmState.caida === 'danger') criticos.push('caída detectada');

      const hayPeligro = criticos.length > 0;

      if (hayPeligro) {
        textEl.textContent = 'Alerta: valor crítico en ' + criticos.join(', ');
        banner.style.display = 'flex';
        ptBeep();
        // Los mails de caída y de vitales van por separado (cada uno con su espera).
        // Se reintentan en cada chequeo (10s) respetando esa espera, mientras siga la emergencia.
        const vitales = criticos.filter(c => c !== 'caída detectada');
        if (ptAlarmState.caida === 'danger') ptSendFallEmail(); // la caída va primero
        if (vitales.length) ptSendEmergencyEmail(vitales);
      } else {
        banner.style.display = 'none';
      }
    }

    function ptStartAlarmLoop() {
      ptStopAlarmLoop();
      ptAlarmTimer = setInterval(ptCheckAlarm, ptAlarmSeconds * 1000);
      ptCheckAlarm(); // chequeo inicial, no hace falta esperar los primeros 10s
    }

    function ptStopAlarmLoop() {
      if (ptAlarmTimer) {
        clearInterval(ptAlarmTimer);
        ptAlarmTimer = null;
      }
    }

    // ==========================================================================
    // DETECCIÓN DE CAÍDAS (acelerómetro MPU6050)
    // Algoritmo: IMPACTO (g alto) -> espera 1s -> quietud (g ~ 1) = CAÍDA.
    // Si después del impacto hay movimiento, se descarta.
    // La pulsera manda la aceleración total en g como 4° dato: "spo2,bpm,temp,g"
    //
    // AJUSTES (versión corregida):
    // - Tolerancia de quietud más amplia (0.5 g) para absorber el ruido del MPU6050.
    // - Alcanza con 1 muestra posterior al impacto (la pulsera puede mandar lento).
    // - Se confirma la caída si al menos el 80% de las muestras están quietas
    //   (antes tenían que estar TODAS quietas).
    // - Si se descarta, la pantalla dice por qué (pocos datos / movimiento).
    // ==========================================================================
    const FALL_IMPACT_G     = 2.5;   // umbral fijo: impacto típico de una caída real
    const FALL_WAIT_MS      = 1000;  // se ignoran las muestras del primer segundo (rebote del impacto)
    const FALL_STILL_MS     = 4000;  // a los 4 s después del impacto se decide
    const FALL_STILL_TOL    = 0.5;   // |g - 1| menor a esto = quieto
    const FALL_MIN_SAMPLES  = 1;     // mínimo de muestras para poder decidir
    const FALL_STILL_RATIO  = 0.8;   // fracción de muestras quietas necesaria

    let fallState = 'idle'; // 'idle' | 'impact' | 'alert'
    let fallSamples = [];
    let fallImpactTs = 0;

    function ptFallUI(mode, title, sub) {
      const card = document.getElementById('pt-fall-card');
      const icon = document.getElementById('pt-fall-icon');
      card.classList.remove('is-active', 'is-alert');
      document.getElementById('pt-fall-dismiss').style.display = 'none';
      if (mode === 'active') {
        card.classList.add('is-active');
        icon.innerHTML = '<i class="ti ti-user-check" aria-hidden="true"></i>';
      } else if (mode === 'alert') {
        card.classList.add('is-alert');
        icon.innerHTML = '<i class="ti ti-alert-triangle" aria-hidden="true"></i>';
        document.getElementById('pt-fall-dismiss').style.display = 'inline-block';
      } else {
        icon.innerHTML = '<i class="ti ti-user-check" aria-hidden="true"></i>';
      }
      document.getElementById('pt-fall-title').textContent = title;
      document.getElementById('pt-fall-sub').textContent = sub;
    }


    function ptProcessG(g) {
      document.getElementById('pt-fall-g').textContent = g.toFixed(2);
      if (fallState === 'alert') return;
      if (fallState === 'idle') {
        ptFallUI('active', 'Monitoreando', 'Acelerómetro activo');
        if (g >= FALL_IMPACT_G) {
          fallState = 'impact';
          fallImpactTs = Date.now();
          fallSamples = [];
          ptFallUI('active', 'Impacto detectado', 'Verificando si la persona se levanta...');
          setTimeout(ptEvaluateFall, FALL_STILL_MS);
        }
      } else if (fallState === 'impact') {
        if (Date.now() - fallImpactTs > FALL_WAIT_MS) fallSamples.push(g);
      }
    }

    function ptEvaluateFall() {
      if (fallState !== 'impact') return;

      console.log('MOON caída: muestras después del impacto =', fallSamples);

      const quietas = fallSamples.filter(g => Math.abs(g - 1) < FALL_STILL_TOL);
      const quieto = fallSamples.length >= FALL_MIN_SAMPLES &&
                     (quietas.length / fallSamples.length) >= FALL_STILL_RATIO;

      if (quieto) {
        ptTriggerFall();
      } else {
        fallState = 'idle';
        const motivo = fallSamples.length < FALL_MIN_SAMPLES
          ? 'Descartado: llegaron muy pocos datos (' + fallSamples.length + ')'
          : 'Descartado: se detectó movimiento';
        ptFallUI('active', 'Monitoreando', motivo);
      }
    }

    function ptTriggerFall() {
      fallState = 'alert';
      ptAlarmState.caida = 'danger';
      const hora = new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
      document.getElementById('pt-fall-last').textContent = 'Hoy ' + hora;
      ptFallUI('alert', '¡Caída detectada!', 'El paciente no se movió después del impacto');
      const profile = ptGetMyProfile();
      if (profile) { profile.lastFall = new Date().toISOString(); ptSaveMyProfile(profile); }
      // Una caída nueva siempre es un evento nuevo: se salta el tiempo de espera
      // y manda el mail enseguida. El límite solo frena los reenvíos repetidos
      // de la MISMA emergencia.
      ptLastFallEmailTs = 0;
      ptCheckAlarm();
    }

    function ptDismissFall() {
      fallState = 'idle';
      ptAlarmState.caida = 'ok';
      ptFallUI('active', 'Monitoreando', 'Acelerómetro activo');
      ptCheckAlarm();
    }


    // ---- Ruteo según sesión / perfil existente ----
    function ptRouteAfterAuth() {
      const session = ptGetSession();
      if (!session) { ptShowView('pt-loginView'); return; }
      const profile = ptGetMyProfile();
      if (profile) ptShowPanel(profile); else ptShowSetup(null);
    }

    // ---- Punto de entrada ----
    if (ptNube) {
      // Firebase recuerda la sesión. Al abrir la página se trae el perfil
      // actualizado de la nube (por si se editó desde otro dispositivo).
      // Mientras Firebase revisa si ya había una sesión, no se muestra el login
      document.getElementById('pt-loginView').style.display = 'none';
      let ptPrimeraVez = true;
      ptAuth.onAuthStateChanged(async (user) => {
        if (!ptPrimeraVez) return;
        ptPrimeraVez = false;
        if (!user) {
          localStorage.removeItem('moon_session');   // sesión vieja sin cuenta en la nube
          ptRouteAfterAuth();
          return;
        }
        ptSetSession({ email: user.email, name: user.displayName || user.email.split('@')[0], uid: user.uid });
        try { await ptNubeSincronizarPerfil(user); }
        catch (e) { console.warn('MOON: sin conexión, se usa el perfil guardado en este dispositivo', e); }
        ptRouteAfterAuth();
      });
    } else {
      ptRouteAfterAuth();
    }
  </script>

</body>
</html>
