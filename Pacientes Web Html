    // ---- Renderiza signos vitales reales (llamar desde la integración con el sensor) ----
    // NOTA: la pulsera sigue mandando "spo2,bpm,temp" por compatibilidad con
    // el firmware, pero temp ya no se usa acá (solo se guarda por si se
    // necesita en el futuro).
    function ptSetLiveVitals(spo2, bpm, temp) {
      const profile = ptGetMyProfile();
      if (!profile) return;
      profile.vitals = { spo2, bpm, temp };
      ptSaveMyProfile(profile);
      ptRenderVitals(spo2, bpm);
    }

    // ==========================================================================
    // BLUETOOTH (cualquier dispositivo, ej. ESP32-C3 Super Mini)
    // ==========================================================================
    /* -------------------------------------------------------------------
       Estos UUID son los del ejemplo estándar de BLE para ESP32 (Arduino/
       Espressif). Si en el código del ESP32-C3 usás otros UUID de servicio
       o de característica, cambialos acá para que coincidan exactamente.

       Del lado del ESP32-C3, la característica de VITALES tiene que mandar
       por "notify" un texto simple con el formato:  spo2,bpm,temp,g
       Ejemplo:  pVitalsChar->setValue("97,78,36.6,1.02"); pVitalsChar->notify();

       -------------------------------------------------------------------
       POR QUÉ SE MUESTRAN TODOS LOS DISPOSITIVOS (no solo los que anuncian
       el servicio de MOON):

       Web Bluetooth no puede leer el modelo del chip (no existe forma de
       filtrar "solo ESP32-C3 Super Mini") ni queremos depender del nombre
       que le pusiste al dispositivo. Por eso se usa acceptAllDevices, que
       hace que el selector del navegador muestre TODOS los dispositivos
       Bluetooth cercanos (no solo ESP32) para poder elegir cualquiera sin
       importar su nombre.

       Como contrapartida, el filtro por servicio ya no evita que aparezcan
       otros dispositivos (auriculares, etc.) en la lista — el usuario es
       quien elige cuál es su pulsera.

       CONEXIÓN "SIEMPRE ACEPTADA":
       Al elegir cualquier dispositivo de la lista, la app se conecta a su
       GATT server (eso es "estar conectado" por Bluetooth) sin importar si
       ese dispositivo tiene o no el servicio de datos de MOON. Si además
       encuentra el servicio/característica de MOON, empieza a recibir
       signos vitales; si no lo encuentra, queda igual conectado, solo que
       sin datos en vivo (por ejemplo, hasta que ajustes el UUID en el
       firmware del ESP32 para que coincida).

       RECONEXIÓN AUTOMÁTICA POR CUENTA:
       Una vez que te conectás con una pulsera, se guarda su identificador
       en este navegador asociado a tu email. La próxima vez que entres con
       esa cuenta (en el mismo navegador), se intenta reconectar sola sin
       tener que elegir de la lista de nuevo. Esto usa
       navigator.bluetooth.getDevices(), disponible en Chrome/Edge
       (no funciona en Safari ni Firefox). Si apretás "Desconectar" a
       propósito, se olvida la pulsera guardada para esa cuenta.

       DESCONEXIÓN (manual o inesperada):
       En ambos casos se dispara el mismo manejador (gattserverdisconnected),
       que actualiza la tarjeta de Bluetooth a "Sin conectar" Y ADEMÁS
       vuelve el panel al estado "esperando datos" (ptRenderWaiting), para
       que no queden mostrándose en pantalla valores viejos como si
       estuvieran en vivo.

       Requisitos para que el Bluetooth funcione:
       - Usar Chrome o Edge (Web Bluetooth no anda en Safari ni Firefox).
         En iPhone/iPad: usar la app Bluefy (ver ptShowBluetoothHelp)
       - La página tiene que estar en HTTPS (GitHub Pages ya lo cumple)
       - Elegir un dispositivo de la lista solo se puede después de tocar
         el botón (por seguridad del navegador, no se puede conectar solo
         la primera vez)
    ------------------------------------------------------------------- */
    const BLE_SERVICE_UUID        = '4fafc201-1fb5-459e-8fcc-c5c9c331914b';
    const BLE_CHARACTERISTIC_UUID = 'beb5483e-36e1-4688-b7f5-ea07361b26a9';

    let bleDevice = null;
    let bleCharacteristic = null;

    // ---- Clave de almacenamiento del dispositivo BLE, atada a la cuenta activa ----
    function ptBleStorageKey() {
      const session = ptGetSession();
      return session ? ('moon_ble_device_' + session.email) : null;
    }
    function ptSaveBleDeviceId(id) {
      const key = ptBleStorageKey();
      if (key) localStorage.setItem(key, id);
    }
    function ptGetSavedBleDeviceId() {
      const key = ptBleStorageKey();
      return key ? localStorage.getItem(key) : null;
    }
    function ptForgetSavedBleDevice() {
      const key = ptBleStorageKey();
      if (key) localStorage.removeItem(key);
    }

    // ---- Actualiza la tarjeta de Bluetooth: estado visual (dot, ícono, texto, botón) ----
    function ptSetBleUI(state, statusText, hintText) {
      // state: 'idle' | 'connecting' | 'connected' | 'error'
      const card = document.getElementById('pt-ble-card');
      const dot = document.getElementById('pt-ble-dot');
      const btn = document.getElementById('pt-ble-btn');
      const statusEl = document.getElementById('pt-ble-status');
      const hintEl = document.getElementById('pt-ble-hint');

      card.classList.remove('is-connected', 'is-connecting', 'is-error');
      dot.classList.remove('connected', 'connecting', 'error');
      btn.classList.remove('connected');
      btn.disabled = false;

      if (state === 'connecting') {
        card.classList.add('is-connecting');
        dot.classList.add('connecting');
        btn.innerHTML = '<i class="ti ti-loader-2" aria-hidden="true"></i> Conectando...';
        btn.disabled = true;
      } else if (state === 'connected') {
        card.classList.add('is-connected');
        dot.classList.add('connected');
        btn.classList.add('connected');
        btn.innerHTML = '<i class="ti ti-bluetooth-off" aria-hidden="true"></i> Desconectar';
        btn.onclick = ptDisconnectBluetooth;
      } else if (state === 'error') {
        card.classList.add('is-error');
        dot.classList.add('error');
        btn.innerHTML = '<i class="ti ti-bluetooth" aria-hidden="true"></i> Reintentar';
        btn.onclick = ptConnectBluetooth;
      } else {
        btn.innerHTML = '<i class="ti ti-bluetooth" aria-hidden="true"></i> Conectar';
        btn.onclick = ptConnectBluetooth;
      }

      if (statusText) statusEl.textContent = statusText;
      if (hintText !== undefined) hintEl.textContent = hintText;
    }

    // ==========================================================================
    // NAVEGADORES SIN BLUETOOTH (iPhone, Safari, Firefox)
    // ==========================================================================
    /* -------------------------------------------------------------------
       Web Bluetooth (navigator.bluetooth) solo existe en navegadores basados
       en Chromium: Chrome, Edge, Opera, Samsung Internet (PC y Android).
       NO existe en Safari, ni en Firefox, ni en NINGÚN navegador de iPhone/
       iPad (Apple obliga a que todos usen el motor de Safari, así que
       "Chrome para iPhone" tampoco tiene Bluetooth).

       Eso no se puede activar desde el código de la página. Lo que se hace
       acá es detectar en qué navegador está la persona y mostrarle la
       solución concreta:
       - iPhone/iPad  -> abrir la página con la app gratuita "Bluefy",
                         que es un navegador para iOS con Web Bluetooth.
       - Firefox      -> abrirla con Chrome (o Edge).
       - Safari Mac   -> abrirla con Chrome o Edge.
    ------------------------------------------------------------------- */
    const PT_BLUEFY_URL = 'https://apps.apple.com/app/bluefy-web-ble-browser/id1492822055';

    function ptDetectBrowser() {
      const ua = navigator.userAgent || '';
      // iPadOS se hace pasar por Mac: se lo distingue por la pantalla táctil
      const isIOS = /iPhone|iPad|iPod/i.test(ua) ||
                    (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1);
      const isAndroid = /Android/i.test(ua);
      const isFirefox = /Firefox|FxiOS/i.test(ua);
      const isSafari = /Safari/i.test(ua) && !/Chrome|Chromium|CriOS|Edg|OPR|FxiOS|Android/i.test(ua);
      return { isIOS, isAndroid, isFirefox, isSafari };
    }

    // Copia el link de esta página para pegarlo en otro navegador
    function ptCopyPageLink(btn) {
      const url = location.href.split('#')[0];
      const ok = () => { btn.innerHTML = '<i class="ti ti-check" aria-hidden="true"></i> Link copiado'; };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(ok, () => prompt('Copiá este link:', url));
      } else {
        prompt('Copiá este link:', url);
      }
    }

    // Muestra en la tarjeta qué hacer según el navegador
    function ptShowBluetoothHelp() {
      const help = document.getElementById('pt-ble-help');
      const b = ptDetectBrowser();
      const copyBtn = '<button type="button" onclick="ptCopyPageLink(this)"><i class="ti ti-link" aria-hidden="true"></i> Copiar link de esta página</button>';
      let html;

      if (b.isIOS) {
        ptSetBleUI('error', 'El iPhone no permite Bluetooth en este navegador', '');
        html = '<b>En iPhone/iPad ningún navegador común tiene Bluetooth web</b> (ni Safari ni Chrome). ' +
               'Usá la app gratuita <b>Bluefy</b>, que sí lo tiene:' +
               '<ol><li>Instalá Bluefy desde el App Store.</li>' +
               '<li>Copiá el link de esta página.</li>' +
               '<li>Abrí Bluefy, pegá el link e iniciá sesión.</li>' +
               '<li>Tocá <b>Conectar</b> y elegí tu pulsera.</li></ol>' +
               '<div class="pt-ble-help-actions">' +
               '<a href="' + PT_BLUEFY_URL + '" target="_blank" rel="noopener"><i class="ti ti-download" aria-hidden="true"></i> Descargar Bluefy</a>' +
               copyBtn + '</div>';
      } else if (b.isFirefox) {
        ptSetBleUI('error', 'Firefox no tiene Bluetooth web', '');
        html = 'Firefox no permite conectarse a dispositivos Bluetooth desde una página. ' +
               'Abrí esta página con <b>Chrome</b> o <b>Edge</b>' + (b.isAndroid ? ' (Chrome ya viene instalado en Android)' : '') + '.' +
               '<div class="pt-ble-help-actions">' + copyBtn + '</div>';
      } else if (b.isSafari) {
        ptSetBleUI('error', 'Safari no tiene Bluetooth web', '');
        html = 'Safari no permite conectarse a dispositivos Bluetooth desde una página. ' +
               'Abrí esta página con <b>Chrome</b> o <b>Edge</b>.' +
               '<div class="pt-ble-help-actions">' + copyBtn + '</div>';
      } else {
        ptSetBleUI('error', 'Este navegador no tiene Bluetooth web', '');
        html = 'Abrí esta página con <b>Chrome</b> o <b>Edge</b> (en PC o Android). ' +
               'En iPhone usá la app <b>Bluefy</b>.' +
               '<div class="pt-ble-help-actions">' + copyBtn + '</div>';
      }
      help.innerHTML = html;
      help.classList.add('show');
