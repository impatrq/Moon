  <script>
    /* ==========================================================================
       MOON – Panel del paciente
       Login / registro / alta del paciente / panel de signos vitales.
       Los signos vitales NO se simulan: esta pantalla está pensada para
       recibir los datos reales de la pulsera (sensor ESP32 con SpO2, BPM y
       temperatura). Mientras no haya un backend conectado, se muestran los
       últimos valores recibidos (guardados en el navegador).

       La sesión se guarda con localStorage (no sessionStorage), por lo que
       queda iniciada en ese navegador aunque se cierre la pestaña o el
       navegador y se vuelva a abrir. Al estar en localStorage, es local a
       cada navegador/dispositivo: no se comparte con el navegador de otra
       persona, y cada quien tiene que iniciar sesión en el suyo.

       -------------------------------------------------------------------
       CONEXIÓN CON LA PULSERA (a implementar):
       Cuando tengas el backend / API / WebSocket de la pulsera ESP32 listo,
       llamá a la función ptSetLiveVitals(spo2, bpm, temp) cada vez que
       lleguen datos nuevos del sensor, por ejemplo:

         // Ejemplo con fetch a un endpoint propio:
         async function pollSensor() {
           const res = await fetch('https://tu-backend.com/api/vitales/' + session.email);
           const data = await res.json(); // { spo2, bpm, temp }
           ptSetLiveVitals(data.spo2, data.bpm, data.temp);
         }
         setInterval(pollSensor, 3000);

         // O con WebSocket:
         const ws = new WebSocket('wss://tu-backend.com/ws');
         ws.onmessage = (ev) => {
           const data = JSON.parse(ev.data);
           ptSetLiveVitals(data.spo2, data.bpm, data.temp);
         };

       NOTA: la temperatura se sigue recibiendo desde la pulsera (formato
       "spo2,bpm,temp") por compatibilidad con el firmware, pero ya NO se
       muestra en el panel ni se usa para diagnóstico/alarma — solo se
       usan SpO2 y BPM.

       -------------------------------------------------------------------
       ALARMA:
       Cada N segundos (10 por defecto) se revisa el último estado de los
       signos vitales. Si alguno está en "danger" (crítico), suena un beep
       y aparece un cartel rojo arriba. La alarma NO se puede silenciar:
       sigue sonando y reenviando el mail de emergencia en cada chequeo
       mientras el valor siga siendo crítico.

       -------------------------------------------------------------------
       DESCONEXIÓN DE LA PULSERA:
       Al desconectarse (manual o inesperadamente), el panel deja de
       mostrar los últimos valores recibidos y vuelve al estado
       "Esperando datos de la pulsera...", y se corta la alarma asociada
       a esos valores (ya no se considera "en vivo").
       ========================================================================== */

    // ---- Enfermedades disponibles ----
    const diseases = [
      { id: 'hta', label: 'Hipertensión', badge: 'pm-badge-warn' },
      { id: 'diabetes', label: 'Diabetes', badge: 'pm-badge-warn' },
      { id: 'epoc', label: 'EPOC', badge: 'pm-badge-danger' },
      { id: 'arritmia', label: 'Arritmia', badge: 'pm-badge-danger' },
      { id: 'asma', label: 'Asma', badge: 'pm-badge-warn' },
      { id: 'anemia', label: 'Anemia', badge: 'pm-badge-info' },
    ];

    let ptSetupActive = new Set();
    let patientActive = new Set();

    // ---- Mostrar / ocultar contraseña ----
    function ptTogglePass(inputId, btn) {
      const input = document.getElementById(inputId);
      const icon = btn.querySelector('i');
      const showing = input.type === 'text';
      input.type = showing ? 'password' : 'text';
      icon.className = showing ? 'ti ti-eye' : 'ti ti-eye-off';
      btn.setAttribute('aria-label', showing ? 'Mostrar contraseña' : 'Ocultar contraseña');
    }

    // ---- Feedback de carga en botones al enviar ----
    function ptSetLoading(btn, text) {
      btn.dataset.originalText = btn.textContent;
      btn.textContent = text;
      btn.disabled = true;
    }
    function ptClearLoading(btn) {
      if (btn.dataset.originalText) btn.textContent = btn.dataset.originalText;
      btn.disabled = false;
    }

    // ---- Vistas ----
    function ptShowView(view) {
      ['pt-loginView','pt-registerView','pt-setupView','pt-panelView'].forEach(id => {
        document.getElementById(id).style.display = (id === view) ? 'block' : 'none';
      });
      document.getElementById('navLogoutWrap').style.display = (view === 'pt-panelView') ? 'block' : 'none';
      document.body.classList.toggle('is-panel', view === 'pt-panelView');
      const ecgBg = document.querySelector('.pt-ecg-bg');
      if (ecgBg) ecgBg.style.display = (view === 'pt-panelView') ? 'none' : 'block';
      if (view !== 'pt-panelView') {
        ptStopAlarmLoop();
        document.getElementById('pt-alarm-banner').style.display = 'none';
      }
    }

    // ---- Sesión y usuarios (demo, guardado en el navegador) ----
    // ==========================================================================
    // CUENTAS EN LA NUBE (Firebase)
    // ==========================================================================
    /* -------------------------------------------------------------------
       Con Firebase configurado, las cuentas y el perfil del paciente se
       guardan en la nube: entrás con el mismo email y contraseña desde
       cualquier celular o compu.
       Si FIREBASE_CONFIG no está completo, la página funciona como antes
       (todo guardado solo en este navegador).

       Cómo configurarlo (gratis, una sola vez):
       1. https://console.firebase.google.com -> "Agregar proyecto".
       2. Compilación -> Authentication -> Comenzar -> activar
          "Correo electrónico/contraseña".
       3. Authentication -> Configuración -> Dominios autorizados ->
          agregar: proyectomoon.github.io
       4. Compilación -> Firestore Database -> Crear base de datos
          (modo producción). En "Reglas" pegar:
            rules_version = '2';
            service cloud.firestore {
              match /databases/{database}/documents {
                match /pacientes/{uid} {
                  allow read, write: if request.auth != null && request.auth.uid == uid;
                }
              }
            }
       5. Configuración del proyecto (engranaje) -> "Tus apps" -> ícono
          web </> -> registrar app -> copiar los valores de firebaseConfig
          acá abajo.
       (Estos valores NO son secretos: está bien que estén en la página.
       Lo que protege los datos son las reglas del paso 4.)
    ------------------------------------------------------------------- */
    const FIREBASE_CONFIG = {
      apiKey:            'TU_API_KEY',
      authDomain:        'TU_PROYECTO.firebaseapp.com',
      projectId:         'TU_PROYECTO',
      storageBucket:     'TU_PROYECTO.appspot.com',
      messagingSenderId: '',
      appId:             ''
    };

    let ptAuth = null, ptDb = null;
    const ptNube = (function () {
      if (FIREBASE_CONFIG.apiKey === 'TU_API_KEY' || !window.firebase) return false;
      try {
        firebase.initializeApp(FIREBASE_CONFIG);
        ptAuth = firebase.auth();
        ptDb = firebase.firestore();
        return true;
      } catch (e) {
        console.error('MOON: no se pudo iniciar Firebase', e);
        return false;
      }
    })();
    if (ptNube) {
      document.getElementById('pt-storageHint').textContent =
        'Tu cuenta se guarda en la nube: entrá desde cualquier dispositivo.';
    }

    // Perfil en la nube: un documento por usuario en "pacientes/<uid>".
    // No se guardan los signos vitales (cambian cada medio segundo).
    async function ptNubeLeerPerfil(uid) {
      const doc = await ptDb.collection('pacientes').doc(uid).get();
      return doc.exists ? doc.data() : null;
    }
    async function ptNubeGuardarPerfil(profile) {
      const user = ptAuth && ptAuth.currentUser;
      if (!user) return;
      const datos = Object.assign({}, profile);
      delete datos.vitals;
      await ptDb.collection('pacientes').doc(user.uid).set(datos);
    }

    // Trae el perfil de la nube y lo deja en este navegador
    async function ptNubeSincronizarPerfil(user) {
      const perfil = await ptNubeLeerPerfil(user.uid);
      if (!perfil) return null;
      const profiles = ptGetProfiles();
      const local = profiles[user.email] || {};
      profiles[user.email] = Object.assign({}, perfil, { vitals: local.vitals || null });
      ptSaveProfiles(profiles);
      return profiles[user.email];
    }

    // Mensajes de error de Firebase en castellano
    function ptNubeError(err) {
      const c = err && err.code || '';
      if (c === 'auth/email-already-in-use') return 'Ya existe una cuenta con ese email';
      if (c === 'auth/invalid-email') return 'El email no es válido';
      if (c === 'auth/weak-password') return 'La contraseña tiene que tener 6 caracteres o más';
      if (c === 'auth/network-request-failed') return 'Sin conexión a internet. Probá de nuevo.';
      if (c === 'auth/too-many-requests') return 'Demasiados intentos. Esperá unos minutos.';
      if (c === 'auth/unauthorized-domain') return 'Falta autorizar este dominio en Firebase (Authentication > Configuración).';
      if (c === 'auth/invalid-credential' || c === 'auth/wrong-password' || c === 'auth/user-not-found' || c === 'auth/invalid-login-credentials')
        return 'Email o contraseña incorrectos.';
      return 'Error: ' + (err && err.message || 'desconocido');
    }

    function ptGetUsers() {
      try { return JSON.parse(localStorage.getItem('moon_users') || '{}'); } catch (e) { return {}; }
    }
    function ptSaveUsers(users) { localStorage.setItem('moon_users', JSON.stringify(users)); }
    function ptGetSession() {
      // localStorage (no sessionStorage): la sesión queda guardada en este
      // navegador aunque se cierre la pestaña/ventana, y no se comparte con
      // el navegador de otra persona.
      try { return JSON.parse(localStorage.getItem('moon_session') || 'null'); } catch (e) { return null; }
    }
    function ptSetSession(s) { localStorage.setItem('moon_session', JSON.stringify(s)); }
    function ptLogout() {
      localStorage.removeItem('moon_session');
      if (ptNube) ptAuth.signOut().catch(() => {});
      document.getElementById('navUser').textContent = '';
      ptStopAlarmLoop();
      document.getElementById('pt-alarm-banner').style.display = 'none';
      if (bleDevice && bleDevice.gatt && bleDevice.gatt.connected) {
        bleDevice.gatt.disconnect();
      }
      ptShowView('pt-loginView');
    }

    // ---- Perfiles de paciente (por email) ----
    function ptGetProfiles() {
      try { return JSON.parse(localStorage.getItem('moon_patient_profiles') || '{}'); } catch (e) { return {}; }
    }
    function ptSaveProfiles(profiles) { localStorage.setItem('moon_patient_profiles', JSON.stringify(profiles)); }
    function ptGetMyProfile() {
      const session = ptGetSession();
      if (!session) return null;
      return ptGetProfiles()[session.email] || null;
    }
    function ptSaveMyProfile(profile) {
      const session = ptGetSession();
      if (!session) return;
      const profiles = ptGetProfiles();
      profiles[session.email] = profile;
      ptSaveProfiles(profiles);
    }

    // ---- Formularios de login / registro ----
    document.getElementById('pt-registerForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const name = document.getElementById('pt-regName').value.trim();
      const email = document.getElementById('pt-regEmail').value.trim().toLowerCase();
      const pass = document.getElementById('pt-regPass').value;
      const errorEl = document.getElementById('pt-registerError');
      const submitBtn = e.target.querySelector('.pt-btn');

      if (!name || !email || pass.length < 6) {
        errorEl.textContent = 'Completá todos los campos (contraseña de 6+ caracteres)';
        errorEl.style.display = 'block';
        return;
      }
      if (ptNube) {
        errorEl.style.display = 'none';
        ptSetLoading(submitBtn, 'Creando cuenta...');
        ptAuth.createUserWithEmailAndPassword(email, pass)
          .then(async (cred) => {
            await cred.user.updateProfile({ displayName: name }).catch(() => {});
            ptSetSession({ email: email, name: name, uid: cred.user.uid });
            ptClearLoading(submitBtn);
            ptRouteAfterAuth();
          })
          .catch((err) => {
            ptClearLoading(submitBtn);
            errorEl.textContent = ptNubeError(err);
            errorEl.style.display = 'block';
          });
        return;
      }

      const users = ptGetUsers();
      if (users[email]) {
        errorEl.textContent = 'Ya existe una cuenta con ese email';
        errorEl.style.display = 'block';
        return;
      }
      errorEl.style.display = 'none';
      ptSetLoading(submitBtn, 'Creando cuenta...');
      users[email] = { name: name, pass: pass };
      ptSaveUsers(users);
      ptSetSession({ email: email, name: name });
      setTimeout(() => { ptClearLoading(submitBtn); ptRouteAfterAuth(); }, 350);
    });

    document.getElementById('pt-loginForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const email = document.getElementById('pt-loginEmail').value.trim().toLowerCase();
      const pass = document.getElementById('pt-loginPass').value;
      const errorEl = document.getElementById('pt-loginError');
      const submitBtn = e.target.querySelector('.pt-btn');

      if (ptNube) {
        errorEl.style.display = 'none';
        ptSetLoading(submitBtn, 'Ingresando...');
        ptNubeLogin(email, pass)
          .then(() => { ptClearLoading(submitBtn); ptRouteAfterAuth(); })
          .catch((err) => {
            ptClearLoading(submitBtn);
            errorEl.textContent = ptNubeError(err);
            errorEl.style.display = 'block';
          });
        return;
      }

      const users = ptGetUsers();
      const user = users[email];
      if (!user || user.pass !== pass) {
        errorEl.textContent = 'Email o contraseña incorrectos.';
        errorEl.style.display = 'block';
        return;
      }
      errorEl.style.display = 'none';
      ptSetLoading(submitBtn, 'Ingresando...');
      ptSetSession({ email: email, name: user.name });
      setTimeout(() => { ptClearLoading(submitBtn); ptRouteAfterAuth(); }, 350);
    });

    // Ingreso con la nube. Si la cuenta todavía no existe en la nube pero sí
    // en este navegador (cuentas creadas antes), se pasa sola a la nube con
    // la misma contraseña y el mismo perfil.
    async function ptNubeLogin(email, pass) {
      let cred;
      try {
        cred = await ptAuth.signInWithEmailAndPassword(email, pass);
      } catch (err) {
        const local = ptGetUsers()[email];
        const noExiste = ['auth/invalid-credential', 'auth/user-not-found', 'auth/invalid-login-credentials'].includes(err.code);
        if (!(noExiste && local && local.pass === pass)) throw err;
        cred = await ptAuth.createUserWithEmailAndPassword(email, pass);   // migración
        await cred.user.updateProfile({ displayName: local.name }).catch(() => {});
        const perfilLocal = ptGetProfiles()[email];
        ptSetSession({ email: email, name: local.name, uid: cred.user.uid });
        if (perfilLocal) await ptNubeGuardarPerfil(perfilLocal);
        const users = ptGetUsers(); delete users[email]; ptSaveUsers(users);  // ya no hace falta la copia local
        return;
      }
      const name = cred.user.displayName || email.split('@')[0];
      ptSetSession({ email: email, name: name, uid: cred.user.uid });
      await ptNubeSincronizarPerfil(cred.user);
    }

    // ---- Formulario de alta / edición del paciente ----
    function ptRenderSetupPills() {
      const el = document.getElementById('pt-setupDiseasePills');
      el.innerHTML = diseases.map(d =>
        `<span class="pm-disease-pill ${ptSetupActive.has(d.id)?'active':''}" onclick="ptToggleSetupDis('${d.id}')" style="display:inline-block;margin:0 8px 8px 0;">${d.label}</span>`
      ).join('');
    }
    function ptToggleSetupDis(id) {
      ptSetupActive.has(id) ? ptSetupActive.delete(id) : ptSetupActive.add(id);
      ptRenderSetupPills();
    }
    function ptRenderDiseaseBadges() {
      const badgesEl = document.getElementById('pt-disease-badges');
      badgesEl.innerHTML = [...patientActive].map(id => {
        const d = diseases.find(x => x.id === id);
        return d ? `<span class="pm-badge ${d.badge}">${d.label}</span>` : '';
      }).join('') || '<span style="font-size:12px;color:var(--text-dim);">Ninguna registrada</span>';
    }

    function ptShowSetup(existing) {
      ptShowView('pt-setupView');
      ptSetupActive = new Set(existing ? existing.diseases : []);
      ptRenderSetupPills();
      const ptSess = ptGetSession();
      const ptCuenta = ptSess ? ptSess.email : '';
      if (existing) {
        document.getElementById('pt-pAlertEmail').value = existing.alertEmail || ptCuenta;
        document.getElementById('pt-pName').value = existing.name || '';
        document.getElementById('pt-pAge').value = existing.age || '';
        document.getElementById('pt-pGender').value = existing.gender || '';
        document.getElementById('pt-pOtras').value = existing.otras || '';
      } else {
        document.getElementById('pt-setupForm').reset();
        document.getElementById('pt-pAlertEmail').value = ptCuenta;
      }
    }

    function ptShowPanel(profile) {
      ptShowView('pt-panelView');
      const session = ptGetSession();
      document.getElementById('pt-hello').textContent = session ? ('Sesión: ' + session.email + ' · Alertas a: ' + (profile.alertEmail || session.email)) : '';
      document.getElementById('navUser').textContent = session ? ('Hola, ' + session.name.split(' ')[0]) : '';

      patientActive = new Set(profile.diseases);
      ptRenderDiseaseBadges();

      const initials = profile.name.trim().split(/\s+/).map(w => w[0]).slice(0, 2).join('').toUpperCase();
      document.getElementById('pt-avatar').textContent = initials || '--';
      document.getElementById('pt-name').textContent = profile.name;
      document.getElementById('pt-meta').textContent = `${profile.age} años · ${profile.gender} · Pulsera MOON`;

      const otrasBox = document.getElementById('pt-otrasBox');
      if (profile.otras && profile.otras.trim()) {
        otrasBox.style.display = 'block';
        document.getElementById('pt-otrasText').textContent = profile.otras;
      } else {
        otrasBox.style.display = 'none';
      }

      // El panel arranca SIEMPRE en "esperando datos": los últimos valores
      // guardados no se muestran como si fueran en vivo hasta que la
      // pulsera esté realmente conectada (ver ptTryAutoReconnect más abajo).
      ptRenderWaiting();

      // Arranca el chequeo periódico de la alarma (cada 10 segundos por defecto)
      ptStartAlarmLoop();

      // Intenta reconectar solo con la pulsera que se eligió la última vez
      // para esta cuenta, sin volver a pedir que se elija de la lista.
      ptCheckBluetoothSupport();
      ptTryAutoReconnect();
    }

    function ptEditProfile() { ptShowSetup(ptGetMyProfile()); }

    document.getElementById('pt-setupForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const name = document.getElementById('pt-pName').value.trim();
      const age = document.getElementById('pt-pAge').value;
      const gender = document.getElementById('pt-pGender').value;
      const otras = document.getElementById('pt-pOtras').value.trim();
      const alertEmailInput = ptLimpiarEmail(document.getElementById('pt-pAlertEmail').value);
      if (alertEmailInput && !ptEmailValido(alertEmailInput)) {
        alert('El email de alertas "' + alertEmailInput + '" no es válido. Revisalo (ej: familiar@gmail.com).');
        return;
      }
      const errorEl = document.getElementById('pt-setupError');
      const submitBtn = e.target.querySelector('.pt-btn');

      if (!name || !age || !gender) {
        errorEl.textContent = 'Completá nombre, edad y género';
        errorEl.style.display = 'block';
        return;
      }
      errorEl.style.display = 'none';
      ptSetLoading(submitBtn, 'Guardando...');

      const existing = ptGetMyProfile();
      const profile = {
        name: name, age: age, gender: gender,
        diseases: [...ptSetupActive],
        otras: otras,
        alertEmail: alertEmailInput || (ptGetSession() ? ptGetSession().email : ''),
        vitals: existing ? existing.vitals : null, // se completa con datos reales de la pulsera
        updatedAt: new Date().toISOString()
      };
      ptSaveMyProfile(profile);
      if (ptNube) {
        ptNubeGuardarPerfil(profile)
          .catch((err) => {
            console.error('MOON: no se pudo guardar el perfil en la nube', err);
            alert('El perfil se guardó en este dispositivo, pero no en la nube (' + (err.code || err.message) + '). Revisá la conexión y volvé a guardar.');
          })
          .finally(() => { ptClearLoading(submitBtn); ptShowPanel(profile); });
        return;
      }
      setTimeout(() => { ptClearLoading(submitBtn); ptShowPanel(profile); }, 300);
    });

    // ---- Estado "esperando datos" (sin pulsera conectada todavía / desconectada) ----
    function ptRenderWaiting() {
      ptStale = false;
      document.getElementById('pt-live-dot').style.background = '#5a6478';
      document.getElementById('pt-live-dot').style.animation = 'none';
      document.getElementById('pt-live-text').textContent = 'Esperando datos de la pulsera...';
      ['spo2','bpm'].forEach(id => {
        document.getElementById('pt-val-'+id).textContent = '--';
