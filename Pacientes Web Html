<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="logo.png" type="image/png">
  <title>MOON – Panel del Paciente</title>
  <meta name="description" content="Panel del paciente MOON: iniciá sesión para ver los signos vitales en tiempo real, el diagnóstico automático y gestionar el perfil médico." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="MOON – Panel del Paciente" />
  <meta property="og:description" content="Iniciá sesión para ver el monitor de signos vitales del paciente en tiempo real." />
  <meta property="og:image" content="https://proyectomoon.github.io/Web/logo-glass.png" />
  <meta property="og:url" content="https://proyectomoon.github.io/Paciente/" />
  <meta name="twitter:card" content="summary_large_image" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  <!-- Firebase: cuentas y perfiles en la nube (para entrar desde cualquier dispositivo) -->
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --night: #0b0f1a;
      --deep: #111827;
      --surface: #161d2e;
      --card: #1e2840;
      --border: #263050;
      --blue: #243869;
      --blue-light: #3a5599;
      --blue-dim: rgba(36, 56, 105, 0.15);
      --moon: #8fa8c8;
      --moon-dim: rgba(143,168,200,0.12);
      --text: #e8edf5;
      --text-muted: #8a96a8;
      --text-dim: #5a6478;
      --white: #FFFFFF;
      --danger: #E24B4A;

      --color-text-primary: #e8edf5;
      --color-text-secondary: #8a96a8;
      --color-background-primary: #1e2840;
      --color-background-secondary: #161d2e;
      --color-border-tertiary: #263050;
      --color-border-secondary: #2e3a58;
      --border-radius-lg: 12px;
      --border-radius-md: 8px;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--night);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      line-height: 1.6;
      min-height: 100vh;
    }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      background: rgba(11,15,26,0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 5%;
      height: 64px;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 0.6rem;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.4rem; font-weight: 700; letter-spacing: 0.2em;
      color: var(--blue);
      text-decoration: none;
    }
    .nav-logo-icon {
      width: 30px; height: auto;
      flex-shrink: 0;
    }
    .nav-links { display: flex; align-items: center; gap: 1.4rem; list-style: none; }
    .nav-links a {
      color: var(--text-muted); text-decoration: none;
      font-size: 0.875rem; font-weight: 500; letter-spacing: 0.05em;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--moon); }
    .nav-user { font-size: 0.8rem; color: var(--text-dim); }
    .nav-logout {
      background: none; border: 1px solid var(--border); color: var(--text-muted);
      font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 500;
      padding: 7px 14px; border-radius: 6px; cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }
    .nav-logout:hover { border-color: var(--danger); color: #f2a3a2; }

    .page-wrap {
      max-width: 640px;
      margin: 0 auto;
      padding: 130px 5% 80px;
      min-height: 100vh;
      position: relative;
    }
    .page-wrap::before {
      content: '';
      position: absolute; top: 10%; left: 50%;
      transform: translate(-50%, -50%);
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(58,85,153,0.10) 0%, transparent 70%);
      pointer-events: none;
      z-index: -1;
    }

    /* ---- FONDO ANIMADO: pulso cardíaco ---- */
    .pt-ecg-bg {
      position: fixed;
      inset: 0;
      overflow: hidden;
      z-index: -2;
      pointer-events: none;
    }
    .pt-ecg-line {
      position: absolute;
      top: 50%;
      left: 0;
      width: 200%;
      height: 160px;
      transform: translateY(-50%);
      animation: pt-ecg-scroll 4s linear infinite;
      opacity: 0.42;
      filter: drop-shadow(0 0 6px rgba(143,168,200,0.55));
    }
    .pt-ecg-line polyline {
      fill: none;
      stroke: var(--moon);
      stroke-width: 3.2;
      stroke-linecap: round;
      stroke-linejoin: round;
      vector-effect: non-scaling-stroke;
    }
    @keyframes pt-ecg-scroll {
      from { transform: translate(0, -50%); }
      to { transform: translate(-50%, -50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .pt-ecg-line { animation: none; }
    }

    .section-label {
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--blue-light); margin-bottom: 0.75rem;
    }
    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 600; line-height: 1.2;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .section-sub {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 2.2rem;
      max-width: 560px;
    }

    /* ---- TARJETAS DE FORMULARIO / LOGIN ---- */
    .pt-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2.2rem;
    }
    .pt-error {
      display: none;
      background: rgba(226,75,74,0.1);
      border: 1px solid var(--danger);
      color: #f2a3a2;
      font-size: 0.8rem;
      padding: 10px 14px;
      border-radius: 8px;
      margin-bottom: 1.2rem;
    }
    .pt-field { margin-bottom: 1.1rem; }
    .pt-field label {
      display: block; font-size: 0.78rem; color: var(--text-muted);
      margin-bottom: 0.4rem; font-weight: 500;
    }
    .pt-field input, .pt-field select {
      width: 100%;
      background: var(--color-background-secondary);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 14px;
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .pt-field input:focus, .pt-field select:focus { border-color: var(--blue-light); }
    .pt-field input::placeholder { color: var(--text-dim); }
    .pt-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.2rem; }
    .pt-field-full { grid-column: 1 / -1; }

    .pt-btn {
      width: 100%;
      background: var(--blue);
      color: var(--white);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600; font-size: 0.9rem; letter-spacing: 0.05em;
      padding: 13px; border-radius: 8px; border: none;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
      margin-top: 0.4rem;
    }
    .pt-btn:hover { background: var(--blue-light); transform: translateY(-1px); }

    .pt-switch { text-align: center; margin-top: 1.4rem; font-size: 0.83rem; color: var(--text-muted); }
    .pt-switch button {
      background: none; border: none; cursor: pointer;
      color: var(--moon); font-weight: 600;
      font-family: 'Inter', sans-serif; font-size: 0.83rem;
    }
    .pt-switch button:hover { text-decoration: underline; }

    .divider-line {
      display: flex; align-items: center; gap: 10px;
      margin: 1.6rem 0;
      color: var(--text-dim);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .divider-line::before, .divider-line::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    .hint-box { font-size: 0.75rem; color: var(--text-dim); text-align: center; line-height: 1.6; }

    .pt-subtitle {
      font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text-muted); margin: 1.4rem 0 0.7rem;
    }

    .pt-panel-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .pt-ghost-btn {
      background: none; border: 1px solid var(--border); color: var(--text-muted);
      font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 500;
      padding: 8px 16px; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
      transition: border-color 0.2s, color 0.2s;
    }
    .pt-ghost-btn:hover { border-color: var(--blue-light); color: var(--moon); }
    .pt-ghost-btn.danger:hover { border-color: var(--danger); color: #f2a3a2; }
    .pt-hello { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0; }

    /* ---- PANEL (estilo monitor, sin controles de simulación) ---- */
    .pm-root { font-family: 'Space Grotesk', 'Inter', sans-serif; }
    .pm-patient { background: var(--color-background-primary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .pm-avatar { width: 52px; height: 52px; border-radius: 50%; background: #1e2840; border: 1.5px solid #3a5599; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 600; color: #8fa8c8; flex-shrink: 0; }
    .pm-patient-info { flex: 1; min-width: 160px; }
    .pm-patient-name { font-size: 16px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 2px; }
    .pm-patient-meta { font-size: 13px; color: var(--color-text-secondary); }
    .pm-badges { display: flex; gap: 8px; flex-wrap: wrap; }
    .pm-badge { font-size: 12px; font-weight: 500; padding: 4px 12px; border-radius: 20px; }
    .pm-badge-warn { background: rgba(239,159,39,0.16); color: #f0b558; border: 1px solid rgba(239,159,39,0.35); }
    .pm-badge-danger { background: rgba(226,75,74,0.16); color: #f18988; border: 1px solid rgba(226,75,74,0.35); }
    .pm-badge-ok { background: rgba(99,153,34,0.16); color: #9bd15a; border: 1px solid rgba(99,153,34,0.35); }
    .pm-badge-info { background: rgba(58,85,153,0.18); color: #8fa8c8; border: 1px solid rgba(58,85,153,0.4); }

    .pm-live-row { display: flex; align-items: center; gap: 8px; margin-bottom: 1rem; font-size: 12.5px; color: var(--text-dim); }
    .pm-live-dot { width: 8px; height: 8px; border-radius: 50%; background: #639922; box-shadow: 0 0 0 0 rgba(99,153,34,0.6); animation: pmPulse 1.8s infinite; }
    @keyframes pmPulse {
      0% { box-shadow: 0 0 0 0 rgba(99,153,34,0.5); }
      70% { box-shadow: 0 0 0 6px rgba(99,153,34,0); }
      100% { box-shadow: 0 0 0 0 rgba(99,153,34,0); }
    }

    .pm-vitals-title { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); margin-bottom: 1rem; }
    .pm-vitals { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 1.5rem; }
    .pm-vital { background: var(--color-background-primary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 1.1rem 1.25rem; position: relative; overflow: hidden; transition: border-color 0.2s; }
    .pm-vital.danger { border-color: #E24B4A; }
    .pm-vital.warning { border-color: #EF9F27; }
    .pm-vital.ok { border-color: #639922; }
    .pm-vital-icon { font-size: 20px; margin-bottom: 10px; }
    .pm-vital-icon.danger { color: #E24B4A; }
    .pm-vital-icon.warning { color: #BA7517; }
    .pm-vital-icon.ok { color: #639922; }
    #pt-icon-bpm i { display: inline-block; animation: pm-heartbeat 1.4s ease-in-out infinite; }
    @keyframes pm-heartbeat {
      0%, 100% { transform: scale(1); }
      15% { transform: scale(1.18); }
      30% { transform: scale(1); }
      45% { transform: scale(1.12); }
      60% { transform: scale(1); }
    }
    .pm-vital-name { font-size: 12px; color: var(--color-text-secondary); margin-bottom: 4px; font-weight: 500; letter-spacing: 0.05em; }
    .pm-vital-val { font-size: 28px; font-weight: 500; color: var(--color-text-primary); line-height: 1; margin-bottom: 3px; }
    .pm-vital-unit { font-size: 12px; color: var(--color-text-secondary); display: inline; }
    .pm-vital-status { font-size: 12px; font-weight: 600; margin-top: 8px; padding: 3px 10px; border-radius: 12px; display: inline-block; }
    .status-danger { background: rgba(226,75,74,0.16); color: #f18988; border: 1px solid rgba(226,75,74,0.35); }
    .status-warning { background: rgba(239,159,39,0.16); color: #f0b558; border: 1px solid rgba(239,159,39,0.35); }
    .status-ok { background: rgba(99,153,34,0.16); color: #9bd15a; border: 1px solid rgba(99,153,34,0.35); }
    .status-est { background: rgba(138,150,168,0.14); color: #8a96a8; border: 1px dashed rgba(138,150,168,0.5); }
    .pm-vital.estimated .pm-vital-val { color: var(--text-muted); }
    .pm-bar { height: 4px; border-radius: 2px; margin-top: 10px; background: var(--color-border-tertiary); }
    .pm-bar-fill { height: 4px; border-radius: 2px; transition: width 0.4s; }

    .pm-diag-title { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-secondary); margin-bottom: 1rem; }
    .pm-diags { display: flex; flex-direction: column; gap: 10px; }
    .pm-diag { display: flex; align-items: flex-start; gap: 12px; background: var(--color-background-secondary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-md); padding: 14px 16px; border-left: 3px solid transparent; }
    .pm-diag.diag-danger { border-left-color: #E24B4A; }
    .pm-diag.diag-warning { border-left-color: #EF9F27; }
    .pm-diag.diag-ok { border-left-color: #639922; }
    .pm-diag-icon { font-size: 20px; flex-shrink: 0; margin-top: 1px; }
    .pm-diag-icon.danger { color: #E24B4A; }
    .pm-diag-icon.warning { color: #BA7517; }
    .pm-diag-icon.ok { color: #639922; }
    .pm-diag-head { font-size: 14px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 2px; }
    .pm-diag-body { font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; }

    .pm-disease-pill {
      font-size: 12.5px; font-weight: 500; padding: 6px 16px; border-radius: 20px; cursor: pointer;
      border: 0.5px solid var(--color-border-secondary); background: var(--color-background-primary);
      color: var(--color-text-secondary); transition: all 0.15s; user-select: none;
    }
    .pm-disease-pill.active { background: #1e2840; color: #8fa8c8; border-color: #3a5599; }

    @media (max-width: 640px) {
      .nav-links { gap: 0.9rem; }
      .pt-card { padding: 1.5rem; }
      .pt-form-grid { grid-template-columns: 1fr; }
    }

    /* ---- Password toggle ---- */
    .pt-field-pass { position: relative; }
    .pt-field-pass input { padding-right: 44px; }
    .pt-pass-toggle {
      position: absolute; right: 4px; top: 30px;
      background: none; border: none; cursor: pointer;
      width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
      color: var(--text-dim); font-size: 1rem;
      transition: color 0.2s;
    }
    .pt-pass-toggle:hover { color: var(--moon); }

    /* ---- Ayuda / contacto ---- */
    .pt-help-link {
      display: block; text-align: center;
      color: var(--text-dim); text-decoration: none;
      font-size: 0.78rem; margin-top: 1rem;
      transition: color 0.2s;
    }
    .pt-help-link:hover { color: var(--moon); }

    /* ---- Feedback de carga en botones ---- */
    .pt-btn[disabled] { opacity: 0.7; cursor: default; transform: none !important; }

    /* ---- FOOTER (consistente con la Web) ---- */
    .pt-footer {
      max-width: 640px; margin: 0 auto;
      padding: 1.6rem 5% 2.2rem;
      border-top: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 0.8rem;
    }
    .pt-footer-logo {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem; font-weight: 700; letter-spacing: 0.2em;
      color: var(--blue);
    }
    .pt-footer-info { font-size: 0.72rem; color: var(--text-dim); text-align: right; line-height: 1.6; }
    @media (max-width: 480px) {
      .pt-footer { flex-direction: column; text-align: center; }
      .pt-footer-info { text-align: center; }
    }

    /* ---- Alarma ---- */
    #pt-alarm-banner {
      display: none;
      position: fixed;
      top: 76px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 300;
      background: var(--danger);
      color: #fff;
      padding: 12px 18px;
      border-radius: 10px;
      align-items: center;
      gap: 12px;
      font-size: 0.82rem;
      font-weight: 600;
      box-shadow: 0 6px 24px rgba(226,75,74,0.45);
      animation: pt-alarm-flash 1s infinite;
      max-width: 90vw;
    }
    #pt-alarm-banner i { font-size: 1.1rem; flex-shrink: 0; }
    @keyframes pt-alarm-flash {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.65; }
    }

    .pt-alarm-settings {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 0.8rem;
      flex-wrap: wrap;
    }
    .pt-alarm-settings input[type="number"] {
      width: 70px;
      background: var(--color-background-secondary);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 5px 8px;
      color: var(--text);
      font-size: 0.78rem;
    }

    /* ---- Tarjeta de conexión Bluetooth (pulsera ESP32-C3) ---- */
    .pt-ble-card {
      background: var(--color-background-primary);
      border: 0.5px solid var(--color-border-tertiary);
      border-radius: var(--border-radius-lg);
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      transition: border-color 0.25s;
    }
    .pt-ble-card.is-connected { border-color: #639922; }
    .pt-ble-card.is-error { border-color: var(--danger); }

    .pt-ble-icon-wrap {
      width: 42px; height: 42px; border-radius: 50%;
      background: var(--color-background-secondary);
      border: 1.5px solid var(--color-border-secondary);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 18px; color: var(--moon);
      transition: border-color 0.25s, color 0.25s;
    }
    .pt-ble-card.is-connected .pt-ble-icon-wrap { border-color: #639922; color: #9bd15a; }
    .pt-ble-card.is-connecting .pt-ble-icon-wrap i { animation: pt-ble-spin 1.1s linear infinite; }
    @keyframes pt-ble-spin { to { transform: rotate(360deg); } }

    .pt-ble-info { flex: 1; min-width: 150px; }
    .pt-ble-name { font-size: 13.5px; font-weight: 500; color: var(--color-text-primary); margin-bottom: 2px; }
    .pt-ble-status-row { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--text-dim); }
    .pt-ble-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--text-dim); flex-shrink: 0; }
    .pt-ble-dot.connected { background: #639922; box-shadow: 0 0 0 0 rgba(99,153,34,0.6); animation: pmPulse 1.8s infinite; }
    .pt-ble-dot.connecting { background: #EF9F27; animation: pt-ble-blink 0.9s infinite; }
    .pt-ble-dot.error { background: var(--danger); }
    @keyframes pt-ble-blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

    .pt-ble-action {
      background: none;
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-family: 'Inter', sans-serif;
      font-size: 0.78rem; font-weight: 500;
      padding: 8px 16px; border-radius: 20px;
      cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
      white-space: nowrap;
    }
    .pt-ble-action:hover { border-color: var(--blue-light); color: var(--moon); }
    .pt-ble-action.connected { border-color: rgba(226,75,74,0.35); color: #f18988; }
    .pt-ble-action.connected:hover { background: rgba(226,75,74,0.1); border-color: var(--danger); }
    .pt-ble-action[disabled] { opacity: 0.6; cursor: default; }

    .pt-ble-hint {
      width: 100%;
      font-size: 11.5px;
      color: var(--text-dim);
      margin-top: 2px;
    }

    /* ---- Ayuda cuando el navegador no tiene Bluetooth ---- */
    .pt-ble-help {
      width: 100%;
      display: none;
      margin-top: 6px;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid rgba(239,159,39,0.45);
      background: rgba(239,159,39,0.08);
      font-size: 12.5px;
      line-height: 1.5;
      color: var(--color-text-primary);
    }
    .pt-ble-help.show { display: block; }
    .pt-ble-help b { font-weight: 600; }
    .pt-ble-help ol { margin: 6px 0 0 18px; padding: 0; }
    .pt-ble-help-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .pt-ble-help-actions a, .pt-ble-help-actions button {
      font-family: 'Inter', sans-serif; font-size: 0.78rem; font-weight: 500;
      padding: 7px 14px; border-radius: 20px; cursor: pointer; text-decoration: none;
      border: 1px solid var(--border); color: var(--moon); background: none;
      display: inline-flex; align-items: center; gap: 6px;
    }

    /* ---- Detección de caídas ---- */
    .pt-fall-card { background: var(--color-background-primary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 1.1rem 1.25rem; margin-bottom: 1.5rem; transition: border-color 0.25s; }
    .pt-fall-card.is-active { border-color: #639922; }
    .pt-fall-card.is-alert { border-color: #E24B4A; animation: pt-alarm-flash 1s infinite; }
    .pt-fall-head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .pt-fall-icon { width: 42px; height: 42px; border-radius: 50%; background: var(--color-background-secondary); border: 1.5px solid var(--color-border-secondary); display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--moon); flex-shrink: 0; }
    .pt-fall-card.is-active .pt-fall-icon { border-color: #639922; color: #9bd15a; }
    .pt-fall-card.is-alert .pt-fall-icon { border-color: #E24B4A; color: #f18988; }
    .pt-fall-info { flex: 1; min-width: 150px; }
    .pt-fall-title { font-size: 14px; font-weight: 500; color: var(--color-text-primary); }
    .pt-fall-sub { font-size: 12px; color: var(--text-dim); }
    .pt-fall-metrics { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.9rem; font-size: 12.5px; color: var(--text-muted); }
    .pt-fall-metrics b { color: var(--text); font-weight: 500; }
    .pt-fall-controls { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 0.9rem; font-size: 0.78rem; color: var(--text-muted); }
    .pt-fall-controls select { background: var(--color-background-secondary); border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; color: var(--text); font-size: 0.78rem; }
    .pt-fall-dismiss { display: none; background: var(--danger); color: #fff; border: none; font-family: 'Inter', sans-serif; font-size: 0.8rem; font-weight: 600; padding: 8px 16px; border-radius: 20px; cursor: pointer; }

    /* ==========================================================================
       REDISEÑO (estilo más profesional)
       Usa SOLO los colores del proyecto MOON (los de la web principal) y
       sus letras de siempre (Space Grotesk e Inter).
       Todo lo de acá abajo solo cambia el aspecto: no cambia textos ni lógica.
       ========================================================================== */
    :root {
      --night: #0b0f1a;
      --card: #1e2840;
      --card-2: #161d2e;
      --border: #263050;
      --accent: #3a5599;
      --accent-2: #8fa8c8;
      --ok: #639922;      --ok-soft: rgba(99,153,34,0.12);
      --warn: #EF9F27;    --warn-soft: rgba(239,159,39,0.12);
      --crit: #E24B4A;    --crit-soft: rgba(226,75,74,0.13);
      --color-background-primary: #1e2840;
      --color-background-secondary: #161d2e;
      --color-border-tertiary: #263050;
      --color-border-secondary: #2e3a58;
      --border-radius-lg: 16px;
      --border-radius-md: 12px;
      --shadow: 0 10px 30px -12px rgba(0,0,0,0.6);
    }
    body {
      background:
        radial-gradient(1200px 600px at 50% -10%, rgba(58,85,153,0.10), transparent 60%),
        var(--night);
      -webkit-font-smoothing: antialiased;
    }
    .page-wrap::before { display: none; }

    /* Barra superior */
    nav { height: 64px; background: rgba(11,15,26,0.85); border-bottom-color: rgba(255,255,255,0.06); }
    .nav-logo { color: #243869; font-size: 1.15rem; letter-spacing: 0.28em; }
    .nav-user { color: var(--text-muted); }
    .nav-logout { border-radius: 999px; padding: 7px 16px; }

    /* Ancho: formularios angostos, panel más ancho en compu */
    .page-wrap { padding: 112px 20px 72px; }
    body.is-panel .page-wrap { max-width: 1080px; }
    body.is-panel .pt-footer { max-width: 1080px; }
    .pt-footer { padding-left: 20px; padding-right: 20px; }

    /* Títulos */
    .section-label { color: var(--accent-2); letter-spacing: 0.18em; }
    .section-title { font-weight: 700; letter-spacing: -0.01em; }
    .pm-vitals-title, .pm-diag-title {
      display: flex; align-items: center; gap: 10px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 12px; letter-spacing: 0.16em; color: var(--text-muted);
      margin: 0 0 0.9rem;
    }
    .pm-vitals-title::after, .pm-diag-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* Tarjetas en general */
    .pt-card, .pm-patient, .pt-ble-card, .pt-fall-card, .pm-vital {
      background: linear-gradient(180deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: var(--border-radius-lg);
      box-shadow: var(--shadow);
    }
    .pt-card { padding: 2rem; }

    /* Formularios */
    .pt-field label { color: #8a96a8; font-size: 0.8rem; }
    .pt-field input, .pt-field select {
      background: #161d2e; border-color: var(--border); border-radius: 10px; padding: 13px 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pt-field input:focus, .pt-field select:focus {
      border-color: var(--accent); box-shadow: 0 0 0 3px rgba(58,85,153,0.18);
    }
    .pt-btn {
      background: linear-gradient(180deg, #3a5599, #243869);
      border-radius: 10px; padding: 14px;
      box-shadow: 0 8px 20px -8px rgba(58,85,153,0.55);
    }
    .pt-btn:hover { background: linear-gradient(180deg, #3a5599, #3a5599); }
    .pt-btn:focus-visible, .pt-ghost-btn:focus-visible, .pt-ble-action:focus-visible, .nav-logout:focus-visible {
      outline: 2px solid var(--accent-2); outline-offset: 2px;
    }
    .pt-ghost-btn { border-radius: 999px; padding: 8px 16px; background: rgba(255,255,255,0.02); }
    .pm-disease-pill { padding: 7px 16px; margin: 0 6px 8px 0; }
    .pm-disease-pill.active { background: rgba(58,85,153,0.15); color: #8fa8c8; border-color: var(--accent); }

    /* Encabezado del panel */
    .pt-panel-top { margin-bottom: 1.25rem; }
    .pt-hello { font-size: 0.82rem; }

    /* Fila superior: Bluetooth + paciente */
    .pt-top-grid { display: grid; gap: 16px; margin-bottom: 1.25rem; }
    .pt-top-grid > .pt-ble-card, .pt-top-grid > .pm-patient { margin-bottom: 0; }
    .pt-ble-card { padding: 1.1rem 1.25rem; }
    .pt-ble-icon-wrap, .pt-fall-icon {
      width: 46px; height: 46px; border-radius: 14px;
      background: rgba(58,85,153,0.10); border: 1px solid rgba(58,85,153,0.25); color: var(--accent-2);
    }
    .pt-ble-card.is-connected { border-color: rgba(99,153,34,0.55); }
    .pt-ble-card.is-connected .pt-ble-icon-wrap { background: var(--ok-soft); border-color: rgba(99,153,34,0.45); color: var(--ok); }
    .pt-ble-card.is-error { border-color: rgba(226,75,74,0.55); }
    .pt-ble-name { font-size: 14.5px; font-weight: 600; }
    .pt-ble-action { padding: 9px 18px; background: rgba(58,85,153,0.12); border-color: rgba(58,85,153,0.4); color: #8fa8c8; }
    .pt-ble-action:hover { background: rgba(58,85,153,0.22); color: #fff; }

    .pm-patient { padding: 1.1rem 1.25rem; gap: 14px; }
    .pm-avatar {
      width: 54px; height: 54px; border-radius: 16px;
      background: linear-gradient(135deg, #243869, #243869); border: none; color: #fff;
      font-family: 'Space Grotesk', sans-serif; font-size: 19px; font-weight: 700;
    }
    .pm-patient-name { font-size: 17px; font-weight: 600; }
    .pm-badge { font-size: 11.5px; padding: 4px 11px; }

    /* Fila "en vivo" */
    .pm-live-row {
      display: inline-flex; padding: 7px 14px; border-radius: 999px;
      background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      color: var(--text-muted); margin-bottom: 1.4rem;
    }

    /* Signos vitales: números grandes, color según el estado */
    .pm-vitals { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 1.75rem; }
    .pm-vital {
      padding: 1.25rem 1.35rem 1.2rem;
      display: grid; grid-template-columns: 1fr auto; grid-template-areas:
        "name icon" "val icon" "bar bar" "status status";
      align-items: start;
    }
    .pm-vital::before {
      content: ''; position: absolute; inset: 0 0 auto 0; height: 3px;
      background: var(--border); transition: background 0.3s;
    }
    .pm-vital.ok::before { background: var(--ok); }
    .pm-vital.warning::before { background: var(--warn); }
    .pm-vital.danger::before { background: var(--crit); }
    .pm-vital.ok { border-color: rgba(99,153,34,0.35); }
    .pm-vital.warning { border-color: rgba(239,159,39,0.45); }
    .pm-vital.danger { border-color: rgba(226,75,74,0.6); box-shadow: 0 0 0 1px rgba(226,75,74,0.25), 0 12px 32px -12px rgba(226,75,74,0.45); }
    .pm-vital-name { grid-area: name; font-size: 13px; color: var(--text-muted); margin-bottom: 6px; }
    .pm-vital > div:nth-of-type(3) { grid-area: val; }
    .pm-vital-icon {
      grid-area: icon; width: 44px; height: 44px; border-radius: 14px; margin: 0;
      display: flex; align-items: center; justify-content: center; font-size: 22px;
      background: rgba(255,255,255,0.04); color: var(--text-muted);
    }
    .pm-vital-icon.ok { background: var(--ok-soft); color: var(--ok); }
    .pm-vital-icon.warning { background: var(--warn-soft); color: var(--warn); }
    .pm-vital-icon.danger { background: var(--crit-soft); color: var(--crit); }
    .pm-vital-val {
      font-family: 'Space Grotesk', sans-serif; font-size: 46px; font-weight: 600;
      letter-spacing: -0.02em; font-variant-numeric: tabular-nums;
    }
    .pm-vital-unit { font-size: 14px; margin-left: 2px; }
    .pm-bar { grid-area: bar; height: 6px; border-radius: 999px; margin-top: 14px; background: rgba(255,255,255,0.06); }
    .pm-bar-fill { height: 6px; border-radius: 999px; min-width: 6px; }
    .pm-vital-status { grid-area: status; justify-self: start; margin-top: 12px; font-size: 11.5px; letter-spacing: 0.03em; padding: 4px 11px; }
    .status-ok { background: var(--ok-soft); color: #9bd15a; border-color: rgba(99,153,34,0.35); }
    .status-warning { background: var(--warn-soft); color: #f0b558; border-color: rgba(239,159,39,0.4); }
    .status-danger { background: var(--crit-soft); color: #f18988; border-color: rgba(226,75,74,0.45); }

    /* Caídas y diagnóstico */
    .pt-bottom-grid { display: grid; gap: 1.75rem; }
    .pt-fall-card { padding: 1.15rem 1.25rem; margin-bottom: 0; }
    .pt-fall-card.is-active { border-color: rgba(99,153,34,0.45); }
    .pt-fall-card.is-active .pt-fall-icon { background: var(--ok-soft); border-color: rgba(99,153,34,0.45); color: var(--ok); }
    .pt-fall-card.is-alert .pt-fall-icon { background: var(--crit-soft); border-color: rgba(226,75,74,0.5); color: var(--crit); }
    .pt-fall-title { font-size: 15px; font-weight: 600; }
    .pt-fall-metrics {
      display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 1rem;
    }
    .pt-fall-metrics > div {
      background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: 10px; padding: 9px 12px;
    }
    .pt-fall-metrics b { font-family: 'Space Grotesk', sans-serif; font-size: 15px; font-variant-numeric: tabular-nums; }
    .pt-fall-dismiss { border-radius: 999px; padding: 9px 18px; }

    .pm-diags { gap: 10px; }
    .pm-diag {
      background: linear-gradient(180deg, var(--card), var(--card-2));
      border: 1px solid var(--border); border-left-width: 3px;
      border-radius: 12px; padding: 14px 16px;
    }
    .pm-diag.diag-ok { border-left-color: var(--ok); }
    .pm-diag.diag-warning { border-left-color: var(--warn); }
    .pm-diag.diag-danger { border-left-color: var(--crit); background: linear-gradient(180deg, rgba(226,75,74,0.08), var(--card-2)); }
    .pm-diag-icon.ok { color: var(--ok); }
    .pm-diag-icon.warning { color: var(--warn); }
    .pm-diag-icon.danger { color: var(--crit); }
    .pm-diag-head { font-weight: 600; }
    #pt-otrasBox { border-radius: 12px !important; border: 1px solid var(--border) !important; }

    /* Cartel de alarma */
    #pt-alarm-banner { border-radius: 12px; padding: 12px 20px; box-shadow: 0 12px 34px rgba(226,75,74,0.5); }

    /* Pie */
    .pt-footer { border-top-color: rgba(255,255,255,0.06); }
    .pt-footer-logo { color: #243869; }

    /* Compu: dos columnas en el panel */
    @media (min-width: 900px) {
      .pt-top-grid { grid-template-columns: 1fr 1.35fr; align-items: stretch; }
      .pt-bottom-grid { grid-template-columns: 1fr 1.35fr; align-items: start; }
    }
    /* Celular */
    @media (max-width: 640px) {
      .page-wrap { padding: 96px 16px 56px; }
      .pt-card { padding: 1.4rem; }
      .pm-vitals { grid-template-columns: 1fr 1fr; gap: 12px; }
      .pm-vital { padding: 1rem 1rem 1rem; grid-template-areas: "name name" "val val" "bar bar" "status status"; grid-template-columns: 1fr; }
      .pm-vital-icon { display: none; }
      .pm-vital-val { font-size: 38px; }
      .pm-vital-name { font-size: 12px; min-height: 2.6em; }
    }
    @media (max-width: 360px) {
      .pm-vitals { grid-template-columns: 1fr; }
    }

    /* Sin barra de progreso ni franja de color arriba en las tarjetas de signos vitales
       (el estado se ve en el borde, el ícono y la etiqueta Normal/Irregular/Crítico) */
    .pm-bar { display: none; }
    .pm-vital::before { content: none; }
    .pm-vital-status:empty { display: none; }
  </style>
</head>
