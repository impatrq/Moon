      // Al no haber datos en vivo, la alarma no debe seguir sonando por
      // valores viejos: se resetea a "ok" y se oculta el cartel.
      ptAlarmState = { spo2: 'ok', bpm: 'ok', caida: ptAlarmState.caida || 'ok' };
