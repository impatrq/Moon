    <!-- FORMULARIO DE ALTA DEL PACIENTE (primera vez) -->
    <div id="pt-setupView" style="display:none;">
      <p class="section-label">Perfil del paciente</p>
      <h1 class="section-title">Contanos sobre el paciente</h1>
      <p class="section-sub">Esta información se guarda asociada a tu cuenta y se usa para personalizar el monitor y el diagnóstico automático de MOON.</p>
      <div class="pt-card">
        <div class="pt-error" id="pt-setupError">Completá los campos obligatorios.</div>
        <form id="pt-setupForm" autocomplete="off">
          <div class="pt-form-grid">
            <div class="pt-field pt-field-full">
              <label for="pt-pName">Nombre completo del paciente</label>
              <input type="text" id="pt-pName" placeholder="Ej: Juan García" autocomplete="off" autocorrect="off" spellcheck="false" required>
